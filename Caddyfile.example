{
	log default {
		format filter {
			wrap json
			fields {
				request>uri query {
					replace code REDACTED
					replace state REDACTED
					replace id_token_hint REDACTED
					replace access_token REDACTED
				}
				request>headers>Referer delete
				resp_headers>Location delete
			}
		}
	}

	servers {
		# Trust client IP headers ONLY when the direct peer is Cloudflare.
		trusted_proxies static 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 104.16.0.0/13 104.24.0.0/14 108.162.192.0/18 131.0.72.0/22 141.101.64.0/18 162.158.0.0/15 172.64.0.0/13 173.245.48.0/20 188.114.96.0/20 190.93.240.0/20 197.234.240.0/22 198.41.128.0/17 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}

	crowdsec {
		api_url http://crowdsec:8080
		api_key {env.CROWDSEC_API_KEY}
		ticker_interval 5s
	}
}

{$POCKETLEDGER_LANDING_DOMAIN}, {$POCKETLEDGER_WEB_DOMAIN}, {$POCKETLEDGER_API_DOMAIN}, {$POCKETLEDGER_IDENTITY_DOMAIN} {
	log {
		hostnames {$POCKETLEDGER_LANDING_DOMAIN} {$POCKETLEDGER_WEB_DOMAIN} {$POCKETLEDGER_API_DOMAIN}
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					replace code REDACTED
					replace state REDACTED
					replace id_token_hint REDACTED
					replace access_token REDACTED
				}
				request>headers>Referer delete
				resp_headers>Location delete
			}
		}
	}
	log identity_access {
		hostnames {$POCKETLEDGER_IDENTITY_DOMAIN}
		output file /var/log/caddy/identity-access.log {
			roll_size 100MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					replace code REDACTED
					replace state REDACTED
					replace id_token_hint REDACTED
					replace access_token REDACTED
				}
				request>headers>Referer delete
				resp_headers>Location delete
			}
		}
	}

	route {
		# Enforce CrowdSec decisions before spending work on the request.
		crowdsec

		# One shared limiter across all PocketLedger public hostnames.
		rate_limit {
			zone pocketledger_global {
				key {client_ip}
				events 400
				window 1m
				ipv6_prefix 64
			}

			zone pocketledger_identity {
				match {
					host {$POCKETLEDGER_IDENTITY_DOMAIN}
				}
				key {client_ip}
				events 100
				window 1m
				ipv6_prefix 64
			}

			# Stricter protection for authentication-related writes without
			# depending on the exact login endpoint path.
			zone pocketledger_identity_post {
				match {
					host {$POCKETLEDGER_IDENTITY_DOMAIN}
					method POST
				}
				key {client_ip}
				events 15
				window 1m
				ipv6_prefix 64
			}

			# The contact form sends email, so repeated submissions are cut off at the edge
			# before they reach the landing service, which applies its own stricter limits.
			zone pocketledger_contact_post {
				match {
					host {$POCKETLEDGER_LANDING_DOMAIN}
					method POST
					path /contact
				}
				key {client_ip}
				events 5
				window 10m
				ipv6_prefix 64
			}

			log_key
		}

		# Internal admin endpoints are service-to-service only (Identity -> API/Web on
		# the Docker network). Never expose them through the public hostnames.
		@internal_admin path /internal-admin/* /api/v1/internal-admin/*
		respond @internal_admin 404

		@landing host {$POCKETLEDGER_LANDING_DOMAIN}
		reverse_proxy @landing landing:5053 {
			# Overwrite any client-supplied value with the Cloudflare-verified client address.
			header_up X-PocketLedger-Client-IP {client_ip}
		}

		@web host {$POCKETLEDGER_WEB_DOMAIN}
		reverse_proxy @web web:5050

		@api host {$POCKETLEDGER_API_DOMAIN}
		reverse_proxy @api https://api:5051 {
			transport http {
				tls_trust_pool file /run/pocketledger-internal-tls/ca.crt
			}
		}

		@identity host {$POCKETLEDGER_IDENTITY_DOMAIN}
		reverse_proxy @identity identity:5052

		respond 404
	}
}
