@using PocketLedger.Localization
@model PocketLedger.Models.ViewModels.Admin.RequestActivityViewModel

<section class="mt-5" aria-labelledby="request-activity-heading">
    <h2 class="h4 mb-2" id="request-activity-heading">@CommonText.Get("Request activity")</h2>
    <p class="text-muted">@CommonText.Get("Requests reaching the web app, API and Identity, in five-minute UTC intervals. Filter by account or client address to see who generated the traffic.")</p>
    <form class="row g-3 align-items-end mb-3" id="request-activity-filters" data-endpoint="@Url.Action("RequestActivity", "Admin")" data-client-endpoint="@Url.Action("RequestClient", "Admin")">
        <div class="col-sm-6 col-lg-2">
            <label class="form-label" for="request-activity-hours">@CommonText.Get("Lookback")</label>
            <select class="form-select" id="request-activity-hours" name="hours">
                @foreach (var hours in Model.AllowedLookbackHours)
                {
                    <option value="@hours" selected="@(hours == Model.SelectedLookbackHours)">@hours hours</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-lg-4">
            <label class="form-label" for="request-activity-user">@CommonText.Get("Activity owner")</label>
            <select class="form-select" id="request-activity-user" name="userId">
                <option value="">@CommonText.Get("All activity (includes anonymous/unattributed)")</option>
            </select>
        </div>
        <div class="col-sm-6 col-lg-3">
            <label class="form-label" for="request-activity-ip">@CommonText.Get("Client IP address")</label>
            <input class="form-control" id="request-activity-ip" name="ip" type="text" inputmode="text" autocomplete="off" spellcheck="false" placeholder="@CommonText.Get("e.g. 203.0.113.10")" value="@Model.SelectedClientIpAddress" />
        </div>
        <div class="col-sm-6 col-lg-3 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit">@CommonText.Get("Apply")</button>
            <button class="btn btn-outline-secondary" type="button" id="request-activity-clear">@CommonText.Get("Clear")</button>
        </div>
    </form>
    <div id="request-activity-state" role="status" aria-live="polite"><span class="text-muted">@CommonText.Get("Loading request activity…")</span></div>
    <div id="request-activity-results" hidden>
        <dl class="row g-3 text-center mb-4" id="request-activity-stats"></dl>
        <div class="request-activity-chart-container">
            <canvas id="request-activity-chart" role="img" aria-label="@CommonText.Get("Requests per minute by five-minute UTC interval")" aria-describedby="request-activity-table-description"></canvas>
        </div>
        <p class="text-muted mt-2 mb-0" id="request-activity-summary"></p>

        <div class="mt-4" id="request-client-details" tabindex="-1" hidden>
            <h3 class="h5 mb-2">@CommonText.Get("Address") <code id="request-client-address"></code> <span id="request-client-badges"></span></h3>
            <div id="request-client-state" role="status" aria-live="polite"></div>
            <div id="request-client-ban-area" class="border rounded-3 p-3 mb-3">
                <p class="mb-2" id="request-client-ban-status"></p>
                <ul class="small mb-2" id="request-client-ban-list"></ul>
                @if (Model.CanManageBans)
                {
                    <form asp-action="BanIp" method="post" class="row g-2 align-items-end" id="request-client-ban-form" hidden>
                        <input type="hidden" name="ip" />
                        <input type="hidden" name="page" value="@Model.UsersPage" />
                        <div class="col-auto">
                            <label class="form-label" for="request-client-ban-duration">@CommonText.Get("Ban for")</label>
                            <select class="form-select" id="request-client-ban-duration" name="durationHours">
                                @foreach (var hours in Model.AllowedBanHours ?? [])
                                {
                                    <option value="@hours" selected="@(hours == 24)">@(hours == 1 ? "1 hour" : hours < 24 ? $"{hours} hours" : hours == 24 ? "1 day" : $"{hours / 24} days")</option>
                                }
                            </select>
                        </div>
                        <div class="col-auto"><button class="btn btn-danger" type="submit">@CommonText.Get("Ban address")</button></div>
                    </form>
                    <form asp-action="UnbanIp" method="post" id="request-client-unban-form" hidden>
                        <input type="hidden" name="address" />
                        <input type="hidden" name="page" value="@Model.UsersPage" />
                        <button class="btn btn-outline-secondary" type="submit">@CommonText.Get("Remove ban on this address")</button>
                    </form>
                }
                else
                {
                    <p class="text-muted small mb-0">@CommonText.Get("Banning from this page is off because no CrowdSec machine account is configured (")<code>CROWDSEC_IDENTITY_MACHINE_PASSWORD</code>).</p>
                }
            </div>
            <p class="mb-2" id="request-client-users"></p>
            <h4 class="h6">@CommonText.Get("Endpoints requested")</h4>
            <div class="table-responsive request-activity-table-container">
                <table class="table table-sm align-middle">
                    <thead><tr><th scope="col">@CommonText.Get("Method")</th><th scope="col">@CommonText.Get("Path")</th><th scope="col">@CommonText.Get("Application")</th><th scope="col">@CommonText.Get("Status")</th><th scope="col">@CommonText.Get("Requests")</th><th scope="col">@CommonText.Get("Last seen (UTC hour)")</th></tr></thead>
                    <tbody id="request-client-endpoints"></tbody>
                </table>
            </div>
            <p class="text-muted small mt-2 mb-0" id="request-client-note"></p>
        </div>

        <div class="mt-4" id="request-clients">
            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mb-2">
                <h3 class="h5 mb-0">@CommonText.Get("Client addresses")</h3>
                <div>
                    <label class="visually-hidden" for="request-clients-filter">@CommonText.Get("Find an address in this list")</label>
                    <input class="form-control form-control-sm" id="request-clients-filter" type="text" autocomplete="off" spellcheck="false" placeholder="@CommonText.Get("Find an address…")" />
                </div>
            </div>
            <div class="table-responsive request-activity-table-container">
                <table class="table table-sm align-middle">
                    <thead><tr><th scope="col">@CommonText.Get("Address")</th><th scope="col">@CommonText.Get("Requests")</th><th scope="col">@CommonText.Get("Failed (4xx/5xx)")</th><th scope="col">@CommonText.Get("First seen (UTC)")</th><th scope="col">@CommonText.Get("Last seen (UTC)")</th><th scope="col"><span class="visually-hidden">@CommonText.Get("Actions")</span></th></tr></thead>
                    <tbody id="request-clients-body"></tbody>
                </table>
            </div>
            <p class="text-muted small mt-2 mb-0" id="request-clients-note"></p>
        </div>

        <details class="mt-4">
            <summary id="request-activity-table-description">@CommonText.Get("Timeline: intervals with traffic, newest first")</summary>
            <div class="table-responsive request-activity-table-container">
                <table class="table table-sm align-middle mt-2">
                    <thead><tr><th scope="col">@CommonText.Get("Interval start (UTC)")</th><th scope="col">@CommonText.Get("Requests/minute")</th><th scope="col">@CommonText.Get("Requests")</th><th scope="col">@CommonText.Get("Failed (4xx/5xx)")</th><th scope="col">@CommonText.Get("Signed in")</th><th scope="col">@CommonText.Get("Anonymous")</th><th scope="col">@CommonText.Get("Addresses")</th><th scope="col">@CommonText.Get("Busiest address")</th></tr></thead>
                    <tbody id="request-activity-table-body"></tbody>
                </table>
            </div>
        </details>
    </div>
    <noscript><div class="alert alert-info mt-3">@CommonText.Get("JavaScript is required to load the request activity chart and its tabular alternative.")</div></noscript>
</section>
