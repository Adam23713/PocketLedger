@model PocketLedger.Models.ViewModels.Admin.AdminDashboardViewModel
@{ ViewData["Title"] = "Admin"; }

<div class="mb-4">
    <h1 class="mb-1">Admin dashboard</h1>
    <p class="text-muted mb-0">Operational overview and user access management for the bootstrap administrator.</p>
</div>

@if (TempData["AdminMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
@if (TempData["AdminWarning"] is string warning)
{
    <div class="alert alert-warning" role="alert">@warning</div>
}

@{ var registration = Model.Registration; }
<section class="card mb-5" aria-labelledby="registration-heading">
    <div class="card-header d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 py-3">
        <div>
            <h2 class="h5 mb-0" id="registration-heading">Registration</h2>
            <p class="text-muted small mb-0">Control public sign-up and how many accounts the instance can hold.</p>
        </div>
        <span class="badge @(registration.AcceptsRegistrations ? "text-bg-success" : registration.IsOpen ? "text-bg-warning" : "text-bg-secondary")">
            @(registration.AcceptsRegistrations ? "Open" : registration.IsOpen ? "Open — no free accounts" : "Closed")
        </span>
    </div>
    <div class="card-body">
        <dl class="row g-3 text-center mb-4">
            <div class="col-4"><div class="border rounded-3 p-3 h-100"><dt class="text-muted fw-normal small">Registered</dt><dd class="fs-3 fw-semibold mb-0" data-registration-registered>@registration.RegisteredUserCount</dd></div></div>
            <div class="col-4"><div class="border rounded-3 p-3 h-100"><dt class="text-muted fw-normal small">Limit</dt><dd class="fs-3 fw-semibold mb-0" data-registration-maximum>@(registration.MaximumUserCount?.ToString() ?? "Unlimited")</dd></div></div>
            <div class="col-4"><div class="border rounded-3 p-3 h-100"><dt class="text-muted fw-normal small">Free</dt><dd class="fs-3 fw-semibold mb-0" data-registration-remaining>@(registration.RemainingSlots?.ToString() ?? "Unlimited")</dd></div></div>
        </dl>
        @if (registration.MaximumUserCount is { } limit && registration.RegisteredUserCount > limit)
        {
            <div class="alert alert-warning" role="status">There are more registered accounts than the limit allows. Existing accounts are kept; new registrations stay blocked until the count drops below the limit.</div>
        }
        <form asp-action="UpdateRegistration" method="post" class="row g-3 align-items-end border-top pt-3">
            <input name="page" type="hidden" value="@Model.Page" />
            <div class="col-12 col-md-auto">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="registration-open" name="isOpen" value="true" @(registration.IsOpen ? "checked" : null) />
                    <input type="hidden" name="isOpen" value="false" />
                    <label class="form-check-label" for="registration-open">Public registration is open</label>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label" for="registration-maximum">Maximum number of accounts</label>
                <input class="form-control" type="number" id="registration-maximum" name="maximumUserCount" min="1" max="@PocketLedger.Configuration.PublicRegistrationOptions.MaximumAllowedUserCount" step="1"
                       value="@registration.MaximumUserCount" placeholder="Unlimited" aria-describedby="registration-maximum-help" />
            </div>
            <div class="col-12 col-md-auto">
                <button class="btn btn-primary" type="submit">Save registration settings</button>
            </div>
            <div class="col-12 form-text mt-1" id="registration-maximum-help">Every account counts toward the limit, including the administrator and blocked accounts. Leave the limit empty for no limit.</div>
        </form>
    </div>
</section>

<section aria-labelledby="user-overview-heading">
    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mb-2">
        <h2 class="h4 mb-0" id="user-overview-heading">Users</h2>
        <span class="text-muted">@Model.TotalUsers total</span>
    </div>
    @if (Model.Users.Count == 0)
    {
        <div class="alert alert-info" role="status">No users are available.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th scope="col">Username</th><th scope="col">Email</th><th scope="col">Last successful login (UTC)</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.Username</td>
                            <td>@(user.Email ?? "Not available")</td>
                            <td>@(user.LastSuccessfulLoginAtUtc?.ToString("u") ?? "Never signed in")</td>
                            <td>@(user.IsAccessBlocked ? "Blocked" : "Active")</td>
                            <td>
                                @if (user.IsBootstrapAdministrator)
                                {
                                    <span class="text-muted">Protected administrator</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        <form asp-action="@(user.IsAccessBlocked ? "Unblock" : "Block")" method="post">
                                            <input name="userId" type="hidden" value="@user.Id" />
                                            <input name="page" type="hidden" value="@Model.Page" />
                                            <button class="btn btn-sm @(user.IsAccessBlocked ? "btn-outline-success" : "btn-outline-warning")" type="submit">@(user.IsAccessBlocked ? "Unblock" : "Block")</button>
                                        </form>
                                        <form asp-action="Delete" method="post" onsubmit="return confirm('Permanently delete this user and all PocketLedger data?');">
                                            <input name="userId" type="hidden" value="@user.Id" />
                                            <input name="page" type="hidden" value="@Model.Page" />
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex align-items-center justify-content-between mt-3" aria-label="User overview pages">
            @if (Model.Page > 1)
            {
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-page="@(Model.Page - 1)" rel="prev">Previous</a>
            }
            else
            {
                <span></span>
            }
            <span class="text-muted">Page @Model.Page of @Model.TotalPages</span>
            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-page="@(Model.Page + 1)" rel="next">Next</a>
            }
            else
            {
                <span></span>
            }
        </nav>
    }
</section>

<partial name="_RequestActivity" model="Model.RequestActivity" />
<partial name="_SuspiciousRequestEvents" model="Model.SuspiciousRequests" />
<partial name="_CrowdSecBans" model="Model.CrowdSecBans" />

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script src="~/js/request-activity.js" asp-append-version="true"></script>
}
