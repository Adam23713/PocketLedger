@using PocketLedger.Localization
@{ ViewData["Title"] = "Identity"; }
<h1>PocketLedger Identity</h1>
@if (User.Identity?.IsAuthenticated == true)
{
    <p>@CommonText.Get("Signed in as") <strong>@User.Identity.Name</strong>.</p>
    <p><a asp-controller="Account" asp-action="LoginEvents">@CommonText.Get("Login Events")</a></p>
}
else
{
    <p><a asp-controller="Account" asp-action="Login">@CommonText.Get("Sign in")</a></p>
}
