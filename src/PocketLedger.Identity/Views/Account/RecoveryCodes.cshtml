@using PocketLedger.Localization
@model PocketLedger.Models.ViewModels.Account.RecoveryCodesViewModel
@{ ViewData["Title"] = CommonText.Get("Recovery codes"); ViewData["HideAuthenticatedNavigation"] = true; }
<h1>@CommonText.Get("Recovery codes")</h1><div class="alert alert-warning">@CommonText.Get("Save these single-use codes now. They will not be shown again.")</div><ul>@foreach (var code in Model.Codes) { <li><code>@code</code></li> }</ul><form asp-action="RecoveryCodes" method="post"><input asp-for="ReturnUrl" type="hidden" /><div><input asp-for="Confirmed" /> <label asp-for="Confirmed">@CommonText.Get("I saved the recovery codes")</label></div><span asp-validation-for="Confirmed" class="text-danger"></span><button class="btn btn-primary mt-3">@CommonText.Get("Continue")</button></form>
