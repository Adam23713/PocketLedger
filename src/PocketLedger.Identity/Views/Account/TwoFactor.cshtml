@using PocketLedger.Localization
@model PocketLedger.Models.ViewModels.Account.TwoFactorViewModel
@{ ViewData["Title"] = CommonText.Get("Authenticator code"); }
<h1>@CommonText.Get("Authenticator code")</h1><form method="post"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Code">@CommonText.Get(Html.DisplayNameFor(model => model.Code))</label><input asp-for="Code" class="form-control" autocomplete="one-time-code" autofocus /><button class="btn btn-primary mt-3">@CommonText.Get("Continue")</button></form><a asp-action="RecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">@CommonText.Get("Use a recovery code")</a>
