@model PocketLedger.Models.ViewModels.Account.CreateDataPasswordViewModel
@{ ViewData["Title"] = "Choose a data password"; ViewData["HideAuthenticatedNavigation"] = true; }
<h1>Choose a data password</h1>
<p>Your sign-in provider confirms who you are, but PocketLedger also encrypts your financial data with a password that only you know.
    You will enter it after each sign-in. It is separate from your provider account's password.</p>
<form method="post">
    <input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus />
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
    </div>
    <button class="btn btn-primary">Continue</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
