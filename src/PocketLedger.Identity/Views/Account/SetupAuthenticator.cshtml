@using PocketLedger.Localization
@model PocketLedger.Models.ViewModels.Account.AuthenticatorSetupViewModel
@{ ViewData["Title"] = CommonText.Get("Configure Microsoft Authenticator"); ViewData["HideAuthenticatedNavigation"] = true; }
<h1>@CommonText.Get("Configure Microsoft Authenticator")</h1><p>@CommonText.Get("Scan this QR code, or enter the shared key manually.")</p><img src="@Model.QrCodeDataUri" alt="@CommonText.Get("Authenticator QR code")" /><p><code>@Model.SharedKey</code></p><form method="post"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Code">@CommonText.Get("Verification code")</label><input asp-for="Code" class="form-control" autocomplete="one-time-code" autofocus /><button class="btn btn-primary mt-3">@CommonText.Get("Verify")</button></form>
