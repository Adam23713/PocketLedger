@using PocketLedger.Localization
@{ ViewData["Title"] = "Registration full"; }

<div class="alert alert-info mt-4" role="status">
    <h1 class="h4">@CommonText.Get("All available accounts are taken")</h1>
    <p class="mb-0">@CommonText.Get("Registration is open, but every available account has already been created. Please check back later.")</p>
</div>
<p><a asp-action="Login">@CommonText.Get("Back to login")</a></p>
