@using PocketLedger.Localization
@model PocketLedger.Models.ViewModels.Account.TwoFactorViewModel
@{ ViewData["Title"] = CommonText.Get("Recovery code"); }
<h1>@CommonText.Get("Recovery code")</h1><p>@CommonText.Get("A successful recovery requires configuring a new authenticator.")</p><form method="post"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Code">@CommonText.Get("Recovery code")</label><input asp-for="Code" class="form-control" autocomplete="off" autofocus /><button class="btn btn-primary mt-3">@CommonText.Get("Recover account")</button></form>
