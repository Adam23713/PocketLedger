@model PocketLedger.Models.ViewModels.Account.RegisterViewModel
@{ ViewData["Title"] = "Register"; }
<div class="auth-shell">
    <div class="card auth-card">
        <div class="auth-header">
            <img class="auth-logo" src="~/images/app-icons/pocketledger-32.png" alt="" width="48" height="48" />
            <h1>Create your account</h1>
            <p class="text-muted">Start tracking your finances with PocketLedger</p>
        </div>
        @if (Model.ExternalProviders.Count > 0)
        {
            <partial name="_ExternalLoginButtons" model="(Model.ExternalProviders, Model.ReturnUrl)" />
            <div class="auth-divider"><span>or register with email</span></div>
        }
        <form method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3"><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" autocomplete="username" /></div>
            <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /></div>
            <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><div class="form-text">At least 14 characters.</div></div>
            <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /></div>
            <button class="btn btn-primary w-100 auth-submit">Register and configure authenticator</button>
        </form>
        <p class="auth-footer">Already have an account? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>
    </div>
</div>
