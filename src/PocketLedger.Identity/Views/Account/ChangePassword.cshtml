@model PocketLedger.Models.ViewModels.Account.ChangePasswordViewModel
@{ var isDataPassword = ViewData["IsDataPassword"] is true; ViewData["Title"] = isDataPassword ? "Change Data Password" : "Change Password"; }
<h1>@ViewData["Title"]</h1>
@if (TempData["PasswordChangeStatus"] is string status)
{
    <div class="alert alert-success" role="status">@status</div>
}
<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="CurrentPassword">@(isDataPassword ? "Current data password" : "Current password")</label>
        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
    </div>
    <div class="mb-3">
        <label asp-for="NewPassword">@(isDataPassword ? "New data password" : "New password")</label>
        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword">@(isDataPassword ? "Confirm new data password" : "Confirm new password")</label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
    </div>
    <button class="btn btn-primary">@(isDataPassword ? "Change data password" : "Change password")</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
