@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Text
@model PocketLedger.Models.ViewModels.Account.LoginViewModel
@{ ViewData["Title"] = Text["Login"].Value; }
<div class="auth-shell">
    <div class="card auth-card">
        <div class="auth-header">
            <img class="auth-logo" src="~/images/app-icons/pocketledger-32.png" alt="" width="48" height="48" />
            <h1>@Text["Welcome back"]</h1>
            <p class="text-muted">@Text["Sign in to your PocketLedger account"]</p>
        </div>
        <div class="mb-3">@await Html.PartialAsync("_LanguageSelector")</div>
        @if (TempData["LoginSuccessMessage"] is string loginSuccessMessage)
        {
            <div class="alert alert-success" role="status">@loginSuccessMessage</div>
        }
        @if (TempData["LoginMessage"] is string loginMessage)
        {
            <div class="alert alert-warning" role="status">@loginMessage</div>
        }
        @if (Model.LockedUntilUtc is { } lockedUntil)
        {
            <div class="alert alert-danger" role="alert">@Text["Too many failed sign-in attempts. Sign-in is blocked until"] <time datetime="@lockedUntil.UtcDateTime.ToString("O")" data-local-time>@lockedUntil.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss") UTC</time>.</div>
        }
        @if (Model.ExternalProviders.Count > 0)
        {
            <partial name="_ExternalLoginButtons" model="(Model.ExternalProviders, Model.ReturnUrl)" />
            <div class="auth-divider"><span>@Text["or sign in with username"]</span></div>
        }
        <form method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3"><label asp-for="Username" class="form-label">@Text["Username"]</label><input asp-for="Username" class="form-control" autocomplete="username" /></div>
            <div class="mb-2"><label asp-for="Password" class="form-label">@Text["Password"]</label><input asp-for="Password" class="form-control" autocomplete="current-password" /></div>
            <div class="mb-3 text-end"><a class="auth-link-small" asp-action="RecoverAccount">@Text["Forgot your password? Use your recovery key"]</a></div>
            <button class="btn btn-primary w-100 auth-submit">@Text["Login"]</button>
        </form>
        @if (Model.RegistrationEnabled)
        {
            <p class="auth-footer">@Text["Need an account?"] <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">@Text["Register"]</a></p>
        }
    </div>
</div>
