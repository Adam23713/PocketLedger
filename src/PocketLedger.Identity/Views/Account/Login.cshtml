@model PocketLedger.Models.ViewModels.Account.LoginViewModel
@{ ViewData["Title"] = "Login"; }
<h1>Login</h1>
<form method="post"><input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Username"></label><input asp-for="Username" class="form-control" autocomplete="username" /></div><div class="mb-3"><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /></div><button class="btn btn-primary">Login</button></form>
@if (Model.RegistrationEnabled)
{
    <p class="mt-3">Need an account? <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a>.</p>
}
@if (Model.ExternalProviders.Count > 0)
{
    <hr />
    <h2 class="h4">Use another account</h2>
    @foreach (var provider in Model.ExternalProviders)
    {
        <form asp-action="ExternalLogin" method="post" class="mb-2">
            <input name="provider" type="hidden" value="@provider.Name" />
            <input name="returnUrl" type="hidden" value="@Model.ReturnUrl" />
            <button class="btn btn-outline-primary" type="submit">Continue with @provider.DisplayName</button>
        </form>
    }
}
