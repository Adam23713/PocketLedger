@using PocketLedger.Security
@{
    var configuration = Context.RequestServices.GetRequiredService<IConfiguration>();
    var themeCookieDomain = configuration["Theme:CookieDomain"];
    var themeCookieSecure = !Context.RequestServices.GetRequiredService<IWebHostEnvironment>().IsDevelopment();
    var showThemeSelector = User.Identity?.IsAuthenticated == true;
    var isBootstrapAdministrator = User.HasClaim(BootstrapAdministratorAuthorization.ClaimType, bool.TrueString);
    var webBaseUrl = configuration["OpenIddict:WebBaseUrl"]!.TrimEnd('/');
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string NavClass(string controller, string action) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en" data-theme="horizon" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PocketLedger Identity</title>
    <script>window.pocketLedgerThemeConfig = { cookieDomain: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(themeCookieDomain)), secure: @themeCookieSecure.ToString().ToLowerInvariant(), migrateLegacyStorage: false };</script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (showThemeSelector)
    {
        <header class="app-header">
            <nav class="navbar navbar-expand-lg" aria-label="Identity navigation">
                <div class="container-fluid">
                    <a class="navbar-brand" href="@webBaseUrl">PocketLedger</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#identity-navigation" aria-controls="identity-navigation" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse" id="identity-navigation">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="@NavClass("Account", "Security")" asp-controller="Account" asp-action="Security" aria-current="@(string.Equals(currentAction, "Security", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Security</a></li>
                            <li class="nav-item"><a class="@NavClass("Account", "LoginEvents")" asp-controller="Account" asp-action="LoginEvents" aria-current="@(string.Equals(currentAction, "LoginEvents", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Login Events</a></li>
                            @if (isBootstrapAdministrator)
                            {
                                <li class="nav-item"><a class="@NavClass("Admin", "Index")" asp-controller="Admin" asp-action="Index" aria-current="@(string.Equals(currentController, "Admin", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Admin</a></li>
                            }
                        </ul>
                    </div>
                    <div class="header-actions">
                        <div class="app-menu">
                            <button class="header-icon-button" id="theme-menu-button" type="button" aria-label="Choose appearance theme" aria-haspopup="menu" aria-expanded="false" aria-controls="theme-menu">
                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.64 5.64l1.42 1.42m9.88 9.88 1.42 1.42m0-12.72-1.42 1.42M7.06 16.94l-1.42 1.42M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" /></svg>
                            </button>
                            <div class="app-dropdown theme-menu" id="theme-menu" role="menu" aria-labelledby="theme-menu-button" hidden>
                                <div class="dropdown-heading">Appearance</div>
                                <button type="button" role="menuitemradio" data-theme-value="horizon" aria-checked="false"><span class="theme-swatch horizon-swatch"></span><span>Horizon</span><span class="theme-check">✓</span></button>
                                <button type="button" role="menuitemradio" data-theme-value="banking" aria-checked="false"><span class="theme-swatch banking-swatch"></span><span>Banking App</span><span class="theme-check">✓</span></button>
                                <button type="button" role="menuitemradio" data-theme-value="glass" aria-checked="false"><span class="theme-swatch glass-swatch"></span><span>Glassmorphism</span><span class="theme-check">✓</span></button>
                                <button type="button" role="menuitemradio" data-theme-value="material" aria-checked="false"><span class="theme-swatch material-swatch"></span><span>Material Design 3</span><span class="theme-check">✓</span></button>
                            </div>
                        </div>
                        <div class="app-menu">
                            <button class="header-icon-button profile-button" id="profile-menu-button" type="button" aria-label="Open profile menu" aria-haspopup="menu" aria-expanded="false" aria-controls="profile-menu">
                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 21a8 8 0 0 0-16 0m12-13a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" /></svg>
                            </button>
                            <div class="app-dropdown profile-menu" id="profile-menu" role="menu" aria-labelledby="profile-menu-button" hidden>
                                <div class="profile-menu-header"><div><strong>@User.Identity?.Name</strong></div></div>
                                <div class="dropdown-divider" role="separator"></div>
                                <form asp-controller="Account" asp-action="Logout" method="post"><button class="logout-action" role="menuitem" type="submit">Logout</button></form>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="container @(showThemeSelector ? "app-content" : "py-4")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
