@{
    var themeCookieDomain = Context.RequestServices.GetRequiredService<IConfiguration>()["Theme:CookieDomain"];
    var themeCookieSecure = !Context.RequestServices.GetRequiredService<IWebHostEnvironment>().IsDevelopment();
    var showThemeSelector = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en" data-theme="horizon" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PocketLedger Identity</title>
    <script>window.pocketLedgerThemeConfig = { cookieDomain: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(themeCookieDomain)), secure: @themeCookieSecure.ToString().ToLowerInvariant(), migrateLegacyStorage: false };</script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="container py-4" role="main">
        @if (showThemeSelector)
        {
            <div class="d-flex justify-content-end mb-3">
                <div class="app-menu">
                    <button class="header-icon-button" id="theme-menu-button" type="button" aria-label="Choose appearance theme" aria-haspopup="menu" aria-expanded="false" aria-controls="theme-menu">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.64 5.64l1.42 1.42m9.88 9.88 1.42 1.42m0-12.72-1.42 1.42M7.06 16.94l-1.42 1.42M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" /></svg>
                    </button>
                    <div class="app-dropdown theme-menu" id="theme-menu" role="menu" aria-labelledby="theme-menu-button" hidden>
                        <div class="dropdown-heading">Appearance</div>
                        <button type="button" role="menuitemradio" data-theme-value="horizon" aria-checked="false"><span class="theme-swatch horizon-swatch"></span><span>Horizon</span><span class="theme-check">✓</span></button>
                        <button type="button" role="menuitemradio" data-theme-value="banking" aria-checked="false"><span class="theme-swatch banking-swatch"></span><span>Banking App</span><span class="theme-check">✓</span></button>
                        <button type="button" role="menuitemradio" data-theme-value="glass" aria-checked="false"><span class="theme-swatch glass-swatch"></span><span>Glassmorphism</span><span class="theme-check">✓</span></button>
                        <button type="button" role="menuitemradio" data-theme-value="material" aria-checked="false"><span class="theme-swatch material-swatch"></span><span>Material Design 3</span><span class="theme-check">✓</span></button>
                    </div>
                </div>
            </div>
        }
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
