<script src="~/js/money-input.js" asp-append-version="true"></script>
<script>
(() => {
    const type = document.getElementById("transaction-type"), sourceAccount = document.getElementById("source-account"), targetAccount = document.getElementById("target-account");
    const targetAccountField = document.getElementById("target-account-field"), categoryField = document.getElementById("category-field"), category = document.getElementById("category-select"), categoryIcon = document.getElementById("category-selected-icon"), adjustmentField = document.getElementById("adjustment-field");
    const amount = document.getElementById("source-amount"), rate = document.getElementById("exchange-rate"), rateField = document.getElementById("exchange-rate-field"), target = document.getElementById("target-amount"), targetDisplay = document.getElementById("target-amount-display"), targetField = document.getElementById("target-amount-field");
    function updateTransfer() {
        const sourceCurrency = sourceAccount.selectedOptions[0]?.dataset.currency, targetCurrency = targetAccount.selectedOptions[0]?.dataset.currency;
        const transfer = type.value === "Transfer", same = sourceCurrency && sourceCurrency === targetCurrency;
        targetAccountField.hidden = !transfer; targetField.hidden = !transfer; rateField.hidden = !transfer || same;
        if (transfer && same) rate.value = "1";
        const result = transfer ? Number(amount.value) * Number(rate.value) : NaN;
        target.value = Number.isFinite(result) ? result.toFixed(4).replace(/\.?0+$/, "") : ""; targetDisplay.value = target.value;
        for (const [id, value] of [["source-currency-suffix", sourceCurrency], ["target-currency-suffix", targetCurrency]]) { const suffix = document.getElementById(id); suffix.textContent = value || ""; suffix.hidden = !value; }
        document.getElementById("exchange-rate-help").textContent = sourceCurrency && targetCurrency ? `1 ${sourceCurrency} = X ${targetCurrency}` : "";
    }
    function updateFields() {
        const adjustment = type.value === "Adjustment", transfer = type.value === "Transfer";
        categoryField.hidden = adjustment || transfer; adjustmentField.hidden = !adjustment;
        if (adjustment || transfer) category.value = "";
        if (!transfer) { targetAccount.value = ""; target.value = ""; rate.value = ""; }
        for (const option of category.options) { if (option.dataset.categoryType) { option.hidden = option.dataset.categoryType !== type.value; option.disabled = option.hidden; } }
        if (category.selectedOptions[0]?.disabled) category.value = "";
        const selected = category.selectedOptions[0]; categoryIcon.src = selected?.dataset.iconPath || ""; categoryIcon.alt = selected?.dataset.iconAlt || ""; categoryIcon.hidden = !selected?.dataset.iconPath;
        updateTransfer();
    }
    [type, sourceAccount, targetAccount, rate].forEach(element => element.addEventListener("change", updateFields)); amount.addEventListener("change", updateTransfer); category.addEventListener("change", updateFields); updateFields();
})();
</script>
