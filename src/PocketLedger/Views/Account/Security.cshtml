@model PocketLedger.Models.ViewModels.Account.AuditLogViewModel
@{ ViewData["Title"] = "Account security"; }
<h1>Account security</h1><table class="table"><thead><tr><th>UTC time</th><th>Event</th><th>Result</th><th>Address</th><th>User agent</th><th>Reason</th></tr></thead><tbody>@foreach (var item in Model.Events) { <tr><td>@item.TimestampUtc.ToString("u")</td><td>@item.EventType</td><td>@item.Outcome</td><td>@(item.ForwardedClientIpAddress ?? item.RemoteIpAddress)</td><td class="text-truncate" style="max-width: 24rem">@item.UserAgent</td><td>@item.FailureReason</td></tr> }</tbody></table><nav>@if (Model.Page > 1) { <a asp-route-page="@(Model.Page - 1)">Previous</a> } @if (Model.Page < Model.TotalPages) { <a asp-route-page="@(Model.Page + 1)">Next</a> }</nav>
