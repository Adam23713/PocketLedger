@model PocketLedger.Models.ViewModels.Account.RegisterViewModel
@{ ViewData["Title"] = "Register"; }
<h1>Register</h1>
<form method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Username"></label><input asp-for="Username" class="form-control" autocomplete="username" /></div><div class="mb-3"><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /></div><div class="mb-3"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /></div><button class="btn btn-primary">Register and configure authenticator</button></form>
