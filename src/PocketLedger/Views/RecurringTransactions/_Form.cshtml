@model PocketLedger.Models.ViewModels.RecurringTransactions.RecurringTransactionFormViewModel
@using PocketLedger.Models.Enums
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="Type" class="form-label"></label><select asp-for="Type" class="form-select" id="recurring-type"><option value="Income">Income</option><option value="Expense">Expense</option><option value="Adjustment">Adjustment</option></select></div>
<div class="mb-3"><label asp-for="AccountId" class="form-label">Account</label><select asp-for="AccountId" class="form-select"><option value="">Select</option>@foreach (var account in Model.Accounts) { <option value="@account.Id">@account.Name (@account.Currency)</option> }</select><span asp-validation-for="AccountId" class="text-danger"></span></div>
<div class="mb-3" id="recurring-category-field"><label asp-for="CategoryId" class="form-label">Category</label><div class="d-flex align-items-center gap-2"><img class="category-icon" id="recurring-category-icon" alt="" hidden /><select asp-for="CategoryId" class="form-select" id="recurring-category"><option value="">Select</option>@foreach (var category in Model.Categories) { <option value="@category.Id" data-category-type="@category.Type" data-icon-path="@category.IconPath" data-icon-alt="@category.IconAlt">@category.Name</option> }</select></div></div>
<div class="mb-3" id="recurring-adjustment-field"><label asp-for="AdjustmentDirection" class="form-label"></label><select asp-for="AdjustmentDirection" asp-items="Html.GetEnumSelectList<AdjustmentDirection>()" class="form-select"><option value="">Select</option></select></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" /><span asp-validation-for="Amount" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Frequency" class="form-label"></label><select asp-for="Frequency" asp-items="Html.GetEnumSelectList<RecurringFrequency>()" class="form-select"></select></div></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="FirstOccurrence" class="form-label"></label><input asp-for="FirstOccurrence" type="date" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="LastOccurrence" class="form-label"></label><input asp-for="LastOccurrence" type="date" class="form-control" id="recurring-last-occurrence" /></div></div>
<div class="form-check mb-3"><input asp-for="NoEndDate" class="form-check-input" id="recurring-no-end-date" /><label asp-for="NoEndDate" class="form-check-label">No end date</label></div>
<div class="mb-3"><label asp-for="Note" class="form-label"></label><textarea asp-for="Note" class="form-control"></textarea></div>
<div class="form-check mb-3"><input asp-for="Enabled" class="form-check-input" /><label asp-for="Enabled" class="form-check-label"></label></div>
<script>
(() => { const type = document.getElementById("recurring-type"), categoryField = document.getElementById("recurring-category-field"), category = document.getElementById("recurring-category"), categoryIcon = document.getElementById("recurring-category-icon"), adjustment = document.getElementById("recurring-adjustment-field"), noEndDate = document.getElementById("recurring-no-end-date"), lastOccurrence = document.getElementById("recurring-last-occurrence");
function update() { const isAdjustment = type.value === "Adjustment"; categoryField.hidden = isAdjustment; adjustment.hidden = !isAdjustment; if (isAdjustment) category.value = ""; for (const option of category.options) { if (!option.dataset.categoryType) continue; option.hidden = option.dataset.categoryType !== type.value; option.disabled = option.hidden; } if (category.selectedOptions[0]?.disabled) category.value = ""; const selected = category.selectedOptions[0]; categoryIcon.src = selected?.dataset.iconPath ?? ""; categoryIcon.alt = selected?.dataset.iconAlt ?? ""; categoryIcon.hidden = !selected?.dataset.iconPath; }
function updateEndDate() { lastOccurrence.disabled = noEndDate.checked; if (noEndDate.checked) lastOccurrence.value = ""; }
type.addEventListener("change", update); category.addEventListener("change", update); noEndDate.addEventListener("change", updateEndDate); update(); updateEndDate(); })();
</script>
