@model PocketLedger.Models.ViewModels.Debts.DebtFormViewModel
@using PocketLedger.Models.Enums
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
<div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="Direction" class="form-label"></label><select asp-for="Direction" asp-items="Html.GetEnumSelectList<DebtDirection>()" class="form-select"></select></div>
<div class="col-md-3"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<DebtType>()" class="form-select"></select></div>
<div class="col-md-6"><label asp-for="CounterpartyName" class="form-label">Person or bank</label><input asp-for="CounterpartyName" class="form-control" /></div>
<div class="col-md-3"><label asp-for="OriginalAmount" class="form-label"></label><input asp-for="OriginalAmount" class="form-control" type="number" step="0.0001" /></div>
<div class="col-md-3"><label asp-for="Currency" class="form-label"></label><input asp-for="Currency" class="form-control" maxlength="3" /></div>
<div class="col-md-3"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" class="form-control" type="date" /></div>
<div class="col-md-3"><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" class="form-control" type="date" /></div>
<div class="col-md-6"><label asp-for="AccountId" class="form-label">Linked/source account</label><select asp-for="AccountId" class="form-select"><option value="">None</option>@foreach (var account in Model.Accounts) { <option value="@account.Id">@account.Name (@account.Currency)</option> }</select></div>
<div class="col-12"><label asp-for="Note" class="form-label"></label><textarea asp-for="Note" class="form-control"></textarea></div>
</div>
<fieldset class="mt-4" id="debt-icon-picker">
    <legend class="form-label">Icon</legend>
    <div class="category-icon-groups">
        @foreach (var group in Model.AvailableIcons.GroupBy(icon => new { icon.Group, icon.GroupDisplayName, icon.CategoryType }))
        {
            <section class="category-icon-group">
                <h2 class="h6">@group.Key.GroupDisplayName</h2>
                <div class="account-icon-grid">
                    @foreach (var icon in group)
                    {
                        <label class="account-icon-option"><input asp-for="Icon" type="radio" value="@icon.Id" /><span class="account-icon-selection"><img src="@icon.WebPath" alt="@icon.DisplayName" /><span class="visually-hidden">@icon.DisplayName</span></span></label>
                    }
                </div>
            </section>
        }
    </div>
    <span asp-validation-for="Icon" class="text-danger"></span>
</fieldset>
<div class="form-check mt-4"><input asp-for="AutomaticPaymentEnabled" class="form-check-input" /><label asp-for="AutomaticPaymentEnabled" class="form-check-label">Enable automatic payment</label></div>
<div class="row g-3 mt-0"><div class="col-md-3"><label asp-for="AutomaticPaymentAmount" class="form-label"></label><input asp-for="AutomaticPaymentAmount" class="form-control" type="number" step="0.0001" /></div><div class="col-md-3"><label asp-for="NextPaymentDate" class="form-label"></label><input asp-for="NextPaymentDate" class="form-control" type="date" /></div><div class="col-md-3"><label asp-for="LastPaymentDate" class="form-label"></label><input asp-for="LastPaymentDate" class="form-control" type="date" /></div><div class="col-md-3"><label asp-for="Frequency" class="form-label"></label><select asp-for="Frequency" asp-items="Html.GetEnumSelectList<RecurringFrequency>()" class="form-select"></select></div></div>
