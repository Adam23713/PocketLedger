@model IReadOnlyList<PocketLedger.Models.ViewModels.Debts.DebtListItemViewModel>
@if (Model.Count == 0) { <div class="alert alert-info">No items.</div> }
else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Direction</th><th>Type</th><th>Account</th><th>Next payment</th><th class="text-end">Original</th><th class="text-end">Remaining</th><th>Status</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><a class="d-flex align-items-center gap-2" asp-action="Details" asp-route-id="@item.Id"><img class="category-icon" src="@item.IconPath" alt="@item.IconAlt" />@item.Name</a></td><td>@item.Direction</td><td>@item.Type</td><td>@(item.AccountName ?? "—")</td><td>@(item.NextPayment?.ToString("yyyy-MM-dd") ?? "—")</td><td class="text-end">@MoneyFormatter.Format(item.OriginalAmount, item.Currency) @item.Currency</td><td class="text-end">@MoneyFormatter.Format(item.RemainingAmount, item.Currency) @item.Currency</td><td>@item.Status</td></tr> }
</tbody></table></div> }
