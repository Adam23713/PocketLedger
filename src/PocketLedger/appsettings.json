{
  "Urls": "http://0.0.0.0:5050",
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "AccountManagement": {
    "MaximumUserCount": 1
  },
  "Authentication": {
    "RateLimitPermitCount": 3,
    "RateLimitWindowSeconds": 60
  },
  "AuthenticationAudit": {
    "RetentionDays": 365
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
