@page "/contact"
@model PocketLedger.Landing.Pages.ContactModel
@inject IConfiguration Configuration
@inject PocketLedger.Landing.IRegistrationStatusProvider RegistrationStatusProvider
@using PocketLedger.Landing.Contact
@{
    var appUrl = Configuration["Landing:AppBaseUrl"]!;
    var registration = await RegistrationStatusProvider.GetAsync(HttpContext.RequestAborted);
    ViewData["AppUrl"] = appUrl;
    const string repository = "https://github.com/Adam23713/PocketLedger";
    var emailError = ViewData.ModelState[nameof(Model.Email)]?.Errors.FirstOrDefault()?.ErrorMessage;
    var messageError = ViewData.ModelState[nameof(Model.Message)]?.Errors.FirstOrDefault()?.ErrorMessage;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Get in touch with the maker of PocketLedger — questions, feedback and ideas are welcome." />
    <meta name="color-scheme" content="dark" />
    <title>Contact — PocketLedger</title>
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="stylesheet" href="/site.css" asp-append-version="true" />
    <script src="/site.js" asp-append-version="true" defer></script>
    @if (Model.IsAvailable && !Model.Sent)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
</head>
<body data-app-url="@appUrl">
    <svg class="icon-definitions" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="0" height="0">
        <symbol id="github-mark" viewBox="0 0 24 24">
            <path fill="currentColor" d="M12 .297C5.37.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.333-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23A11.5 11.5 0 0 1 12 6.1c1.02.005 2.045.138 3.003.403 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </symbol>
    </svg>
    <a class="skip-link" href="#main">Skip to content</a>
    @await Html.PartialAsync("_DevelopmentBanner", registration)
    <header class="header">
        <nav class="shell nav" aria-label="Main navigation">
            <a class="brand" href="/"><img src="/images/logo.png" width="34" height="34" alt="" />PocketLedger</a>
            <div class="nav-links"><a href="/">Home</a><a href="/contact" aria-current="page">Contact</a><a class="github-link" href="@repository" target="_blank" rel="noopener noreferrer"><svg class="github-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href="#github-mark"></use></svg>GitHub ↗</a></div>
            <a class="button button-login button-small" data-app-link href="@(appUrl + "/Session/Login")"><span data-app-label>Log in</span><span class="login-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h5a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-5M4 12h11m-4-4 4 4-4 4" /></svg></span></a>
        </nav>
    </header>
    <main id="main">
        <section class="contact shell" aria-labelledby="contact-title">
            <div class="contact-intro">
                <p class="eyebrow">GET IN TOUCH</p>
                <h1 id="contact-title">Questions, ideas<br /><span>or feedback?</span></h1>
                <p>Whether something is not working, you are missing a feature, or you would simply like to share how you use PocketLedger.</p>
                <ul class="contact-points">
                    <li>Found a bug or have a feature idea? You can also <a class="text-link" href="@(repository + "/issues")" target="_blank" rel="noopener noreferrer">open an issue on GitHub ↗</a></li>
                    <li>Questions about your data are answered on the <a class="text-link" href="/privacy">Privacy</a> page.</li>
                </ul>
            </div>
            <div class="contact-card">
                @if (Model.Sent)
                {
                    <div class="contact-success" role="status">
                        <span class="contact-success-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg></span>
                        <h2>Thank you, your message is on its way.</h2>
                        <p>I will reply to the email address you provided, usually within a few days.</p>
                        <a class="text-link" href="/">← Back to the home page</a>
                    </div>
                }
                else if (!Model.IsAvailable)
                {
                    <div class="contact-unavailable" role="status">
                        <h2>The contact form is resting for a moment.</h2>
                        <p>It is not available right now. Please check back a little later, or reach out through <a class="text-link" href="@(repository + "/issues")" target="_blank" rel="noopener noreferrer">GitHub ↗</a> in the meantime.</p>
                    </div>
                }
                else
                {
                    <form class="contact-form" method="post" novalidate data-contact-form>
                        <h2>Send a message</h2>
                        @if (Model.ErrorMessage is not null)
                        {
                            <p class="form-alert" role="alert">@Model.ErrorMessage</p>
                        }
                        <input type="hidden" name="FormStamp" value="@Model.FormStamp" />
                        <div class="form-field">
                            <label for="contact-email">Your email address</label>
                            <input id="contact-email" name="Email" type="email" inputmode="email" autocomplete="email" required maxlength="@ContactMessageValidator.MaximumEmailLength" value="@Model.Email" aria-describedby="contact-email-help@(emailError is null ? "" : " contact-email-error")" aria-invalid="@(emailError is null ? null : "true")" />
                            <p class="form-help" id="contact-email-help">I will only use it to reply to you.</p>
                            @if (emailError is not null) { <p class="form-error" id="contact-email-error">@emailError</p> }
                        </div>
                        <div class="form-field">
                            <label for="contact-message">Message</label>
                            <textarea id="contact-message" name="Message" rows="8" required minlength="@ContactMessageValidator.MinimumMessageLength" maxlength="@ContactMessageValidator.MaximumMessageLength" aria-describedby="contact-message-help@(messageError is null ? "" : " contact-message-error")" aria-invalid="@(messageError is null ? null : "true")" data-character-counter>@Model.Message</textarea>
                            <p class="form-help" id="contact-message-help"><span>Plain text only, up to @ContactMessageValidator.MaximumLinkCount links.</span><span data-character-count aria-live="polite"></span></p>
                            @if (messageError is not null) { <p class="form-error" id="contact-message-error">@messageError</p> }
                        </div>
                        <div class="form-trap" aria-hidden="true">
                            <label for="contact-website">Leave this field empty</label>
                            <input id="contact-website" name="Website" type="text" tabindex="-1" autocomplete="off" />
                        </div>
                        <div class="cf-turnstile" data-sitekey="@Model.TurnstileSiteKey" data-action="@TurnstileVerifier.Action" data-theme="dark" data-size="flexible"></div>
                        <button class="button contact-submit" type="submit">Send message <span aria-hidden="true">→</span></button>
                        <p class="form-note">Your message is delivered to my inbox by email and is not stored on this website. See the <a class="text-link" href="/privacy#data-we-collect">Privacy</a> page for details.</p>
                    </form>
                }
            </div>
        </section>
    </main>
    <footer class="shell footer"><a class="brand" href="/"><img src="/images/logo.png" width="28" height="28" alt="" />PocketLedger</a><a href="/privacy">Privacy</a><a href="/contact">Contact</a><p>Made by <a href="https://www.linkedin.com/in/%C3%A1d%C3%A1m-kert%C3%A9sz-b6a541149/" target="_blank" rel="noopener noreferrer">Ádám Kertész</a></p><a class="github-link" href="@repository" target="_blank" rel="noopener noreferrer"><svg class="github-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href="#github-mark"></use></svg>GitHub ↗</a><span>AGPL-3.0-only</span></footer>
</body>
</html>
