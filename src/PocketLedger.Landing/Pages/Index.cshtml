@page "/"
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Text
@inject IConfiguration Configuration
@inject PocketLedger.Landing.IRegistrationStatusProvider RegistrationStatusProvider
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@{
    var appUrl = Configuration["Landing:AppBaseUrl"]!;
    var videoEmbedUrl = Configuration["Landing:YouTubeEmbedUrl"];
    var registration = await RegistrationStatusProvider.GetAsync(HttpContext.RequestAborted);
    var registrationEnabled = registration.AcceptsRegistrations;
    ViewData["AppUrl"] = appUrl;
    const string repository = "https://github.com/Adam23713/PocketLedger";
    var landingPageImage = FileVersionProvider.AddFileVersionToPath(HttpContext.Request.PathBase, "/images/landing_page.webp");
    var landingPageSmallImage = FileVersionProvider.AddFileVersionToPath(HttpContext.Request.PathBase, "/images/landing_page-small.webp");
    var screenshots = new[] {
        ("dashboard", Text["OVERVIEW"].Value, Text["Your money at a glance"].Value, Text["The dashboard brings every account balance, your net worth and this month’s income and expenses together on one screen. The latest transactions sit right below, so you always know where things stand."].Value, 1500, 1000),
        ("trs", Text["TRANSACTIONS"].Value, Text["Income, expenses & transfers"].Value, Text["Record what comes in, what goes out and what moves between your accounts. Filter by year, month or category, and every day shows its own incoming and outgoing totals."].Value, 1340, 796),
        ("statics", Text["STATISTICS"].Value, Text["See where it all goes"].Value, Text["Statistics break your spending and income down by category and account, with a twelve-month trend that shows how your habits change over time."].Value, 1355, 798),
        ("calendar", Text["CALENDAR"].Value, Text["Your finances, on a calendar"].Value, Text["Follow your financial activity day by day. Each day shows its income, expenses and running total, so busy weeks and quiet ones are easy to spot."].Value, 1358, 812),
        ("loans", Text["LOANS & DEBTS"].Value, Text["Keep track of loans & debts"].Value, Text["Know what you owe and what is owed to you. Record repayments as they happen and keep the remaining balance of every loan up to date."].Value, 1360, 793),
        ("recurring", Text["RECURRING"].Value, Text["Make room for the recurring"].Value, Text["Salaries, rent and subscriptions repeat on the schedule you set, and PocketLedger books them for you, so regular income and expenses stay in view."].Value, 1342, 553),
        ("categories", Text["CATEGORIES"].Value, Text["A place for every transaction"].Value, Text["Organize your finances with your own categories and subcategories, each with its own icon, grouped into income and expenses."].Value, 1348, 656),
        ("settings", Text["SETTINGS"].Value, Text["Make PocketLedger yours"].Value, Text["Choose your appearance from multiple themes, set your currencies and number formats, and pick the timezone your dates follow."].Value, 1321, 873)
    };
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="@Text["PocketLedger is a free, open-source personal finance app for tracking accounts, spending, income and debts. Use the hosted instance or run it on your own server."]" />
    <meta name="color-scheme" content="dark" />
    <title>@Text["PocketLedger — See more clearly today"]</title>
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="stylesheet" href="/site.css" asp-append-version="true" />
    <script src="/site.js" asp-append-version="true" defer></script>
</head>
<body data-log-in="@Text["Log in"]" data-video-title="@Text["PocketLedger video"]" data-fit-screen="@Text["Fit to screen"]" data-zoom-in="@Text["Zoom in"]" data-app-url="@appUrl">
    <svg class="icon-definitions" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="0" height="0">
        <symbol id="github-mark" viewBox="0 0 24 24">
            <path fill="currentColor" d="M12 .297C5.37.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.333-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23A11.5 11.5 0 0 1 12 6.1c1.02.005 2.045.138 3.003.403 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </symbol>
    </svg>
    <a class="skip-link" href="#main">@Text["Skip to content"]</a>
    @await Html.PartialAsync("_DevelopmentBanner", registration)
    @await Html.PartialAsync("_Header", "home")
    <main id="main">
        <section class="hero shell" aria-labelledby="hero-title">
            <div class="eyebrow"><span class="status-dot" aria-hidden="true"></span> @Text["PERSONAL FINANCE. FREE & OPEN SOURCE."]</div>
            <h1 id="hero-title">@Text["See more clearly today."]<br /><span>@Text["Live more confidently tomorrow."]</span></h1>
            <p class="hero-copy">@Text["Financial security does not necessarily begin when you have more money. It begins when you understand what is happening with what you already have."]</p>
            <div class="actions">@if (registrationEnabled) { <a class="button" data-registration-link href="@(appUrl + "/Session/Register")">@Text["Create account"]</a> }<a class="button button-login" data-app-link data-open-app="@Text["Open PocketLedger"]" href="@(appUrl + "/Session/Login")"><span data-app-label>@Text["Log in"]</span><span class="login-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h5a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-5M4 12h11m-4-4 4 4-4 4" /></svg></span></a><a class="button button-github github-link" href="@repository" target="_blank" rel="noopener noreferrer"><svg class="github-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href="#github-mark"></use></svg>@Text["Explore on GitHub"] <span aria-hidden="true">↗</span></a></div>
            <p class="hero-note">@Text["It does not require a subscription."]</p>
            <figure class="hero-image">
                <a href="@landingPageImage" data-gallery-image aria-label="@Text["View PocketLedger dashboard and themes"]">
                    <img src="@landingPageImage" srcset="@landingPageSmallImage 800w, @landingPageImage 1672w" sizes="(max-width: 1200px) 94vw, 1180px" width="1672" height="941" fetchpriority="high" alt="@Text["PocketLedger dashboard showing account balances, recent transactions and four different appearance themes"]" />
                </a>
                <figcaption><span>@Text["ONE APP. YOUR CHOICE OF THEME."]</span><span>@Text["Explore the details ↗"]</span></figcaption>
            </figure>
        </section>
        @if (!string.IsNullOrEmpty(videoEmbedUrl))
        {
            <section class="section shell video-section" id="video" aria-labelledby="video-title">
                <div class="video-layout">
                <div><p class="eyebrow">@Text["SEE IT IN ACTION"]</p><h2 id="video-title">@Text["A quick tour of PocketLedger."]</h2><p>@Text["Watch a short walkthrough, and switch to full screen if you'd like a closer look."]</p></div>
                @* Nothing is requested from YouTube until the visitor chooses to play the video. *@
                <div class="video-frame" data-video-frame>
                    <button class="video-placeholder" type="button" data-video-src="@(videoEmbedUrl)?autoplay=1">
                        <span class="video-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><path d="M8 5v14l11-7Z" fill="currentColor" /></svg></span>
                        <span class="video-placeholder-title">@Text["Play the video"]</span>
                        <span class="video-placeholder-note">@Text["The video is loaded from YouTube (Google) only after you click. See our"] <a class="text-link" href="/privacy#who-we-share-it-with">@Text["Privacy Policy"]</a>.</span>
                    </button>
                </div>
                </div>
            </section>
        }
        <section class="section shell" id="features" aria-labelledby="features-title">
            <div class="section-heading"><div><p class="eyebrow">@Text["THE EVERYDAY ESSENTIALS"]</p><h2 id="features-title">@Text["Less guesswork."]<br />@Text["More understanding."]</h2></div><p>@Text["From your morning coffee to the bigger picture, keep the details together and the overview clear."]</p></div>
            <div class="features">
                <article><span class="feature-number">@Text["01 / ORGANIZE"]</span><h3>@Text["Every account, in view"]</h3><p>@Text["Bring accounts, income, expenses and transfers into one overview. Use categories to give every transaction a place."]</p></article>
                <article><span class="feature-number">@Text["02 / UNDERSTAND"]</span><h3>@Text["See the bigger picture"]</h3><p>@Text["Explore statistics, follow your calendar and track recurring transactions, loans and debts."]</p></article>
                <article><span class="feature-number">@Text["03 / MAKE IT YOURS"]</span><h3>@Text["Your money, your setup"]</h3><p>@Text["Work with multiple currencies, choose from multiple themes and keep your data portable with backup, import and export."]</p></article>
            </div>
            <ol class="tour" aria-label="@Text["A tour of PocketLedger"]">
                @for (var i = 0; i < screenshots.Length; i++)
                {
                    var shot = screenshots[i];
                    <li class="tour-step">
                        <a class="tour-image" href="/images/@(shot.Item1).webp" data-gallery-image aria-label="@Text["{0} — view full-size screenshot", shot.Item3]">
                            <img src="/images/@(shot.Item1).webp" srcset="/images/@(shot.Item1)-small.webp 800w, /images/@(shot.Item1).webp @(shot.Item5)w" sizes="(max-width: 720px) 86vw, (max-width: 1200px) 56vw, 680px" width="@shot.Item5" height="@shot.Item6" loading="lazy" decoding="async" alt="@Text["{0} — PocketLedger application screenshot", shot.Item3]" />
                        </a>
                        <div class="tour-rail" aria-hidden="true"><span></span></div>
                        <div class="tour-copy">
                            <span class="tour-index">@((i + 1).ToString("00")) / @shot.Item2</span>
                            <h3>@shot.Item3</h3>
                            <p>@shot.Item4</p>
                            <span class="tour-zoom" aria-hidden="true">@Text["Click the screenshot to enlarge ↗"]</span>
                        </div>
                    </li>
                }
            </ol>
        </section>
        <section class="security section shell" id="security" aria-labelledby="security-title">
            <div class="security-panel">
                <div class="security-intro">
                    <div><p class="eyebrow">@Text["YOUR DATA, PROTECTED BY DESIGN"]</p><h2 id="security-title">@Text["Your finances stay yours."]</h2></div>
                    <div class="security-copy">
                        <p>@Text["Your account names, notes, debts and planner history are locked with a key that only your password can open. We never store that password, so nothing we hold can unlock your data — not the database, not our server keys, not our cloud vault."]</p>
                        <p class="security-highlight">@Text["Even if we wanted to, we could not read it. Without your password or your recovery key, nobody — including us — can."]</p>
                    </div>
                </div>
                <ol class="security-layers" aria-label="@Text["Layers of protection"]">
                    <li><span class="layer-index">@Text["01 / YOUR PASSWORD"]</span><h3>@Text["A key only you can open"]</h3><p>@Text["Your sensitive text is encrypted with a personal key, unlocked only by your password or your one-time recovery key. We keep just a one-way hash of the password and never see the recovery key."]</p></li>
                    <li><span class="layer-index">@Text["02 / SERVER KEYS"]</span><h3>@Text["A second lock on every field"]</h3><p>@Text["Everything encrypted — your personal layer included — is encrypted again with separate, service-specific key rings kept outside the database, so a copied database holds only ciphertext."]</p></li>
                    <li><span class="layer-index">@Text["03 / OCI VAULT"]</span><h3>@Text["Keys kept in a vault"]</h3><p>@Text["Those key rings are secured through OCI Vault/KMS, so a stolen server disk on its own is not enough to unlock the protected fields."]</p></li>
                    <li><span class="layer-index">@Text["04 / TWO-FACTOR"]</span><h3>@Text["Two steps to every sign-in"]</h3><p>@Text["Every account is protected by an authenticator app, so a leaked password alone does not get anyone into your account."]</p></li>
                </ol>
                <p class="security-footnote">@Text["Amounts, dates and account types are protected by the server keys and the vault rather than by your password, so balances and statistics can still be calculated. We never sell your data or share it with advertisers, analytics providers or data brokers. See the"] <a class="text-link" href="/privacy">@Text["Privacy"]</a> @Text["page, or read the"] <a class="text-link" href="@(repository + "/blob/main/docs/database-encryption.md")" target="_blank" rel="noopener noreferrer">@Text["database encryption"]</a> @Text["and"] <a class="text-link" href="@(repository + "/blob/main/docs/oci-kms.md")" target="_blank" rel="noopener noreferrer">OCI KMS</a> @Text["documentation on GitHub."]</p>
            </div>
        </section>
        <section class="story section" id="open-source" aria-labelledby="story-title">
            <div class="shell story-grid"><div><p class="eyebrow">@Text["A PERSONAL PROJECT, SHARED OPENLY"]</p><h2 id="story-title">@Text["PocketLedger exists to make"]<br /><span>@Text["that journey a little easier."]</span></h2></div><div class="story-copy"><p>@Text["I know what it feels like to come from a family where money does not automatically mean security. And I also know how difficult it is, as an adult, to learn the things about money that someone probably should have taught you much earlier."]</p><p>@Text["To help you track your money. To help you plan. To help you notice patterns. And over time, to help you make more confident decisions."]</p><p>@Text["Because financial awareness should not be a premium feature."]</p><a class="text-link github-link" href="@repository" target="_blank" rel="noopener noreferrer"><svg class="github-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href="#github-mark"></use></svg>@Text["Take a look at the source"] <span aria-hidden="true">↗</span></a></div></div>
        </section>
        <section class="section shell" id="self-hosting" aria-labelledby="hosting-title">
            <p class="eyebrow">@Text["CHOOSE WHAT WORKS FOR YOU"]</p><h2 id="hosting-title">@Text["A home for your finances."]</h2>
            <div class="hosting-grid">
                <article class="hosting-card"><span class="pill">@Text["FREE HOSTED POCKETLEDGER"]</span><h3>@Text["Let me take care"]<br />@Text["of the hosting."]</h3><p>@Text["I run a PocketLedger instance that is currently free to use. I cover the server costs myself, so account availability is limited."]</p><p>@if (registrationEnabled) { <span data-registration-content>@Text["Create an account or sign in below."]</span> } else { <span>@Text["Already have an account? You can sign in below."]</span> }</p><div class="hosting-actions">@if (registrationEnabled) { <a class="button" data-registration-link href="@(appUrl + "/Session/Register")">@Text["Create account"]</a> }<a class="button button-login" data-app-link data-open-app="@Text["Open PocketLedger"]" href="@(appUrl + "/Session/Login")"><span data-app-label>@Text["Log in"]</span><span class="login-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h5a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-5M4 12h11m-4-4 4 4-4 4" /></svg></span></a></div></article>
                <article class="hosting-card self-host"><span class="pill">@Text["SELF-HOSTED · AGPL-3.0-ONLY"]</span><h3>@Text["Your server."]<br />@Text["Your own instance."]</h3><p>@Text["Run PocketLedger on your own server, fork it and change it to suit your needs under the AGPL-3.0-only license. You don’t have to use my hosted instance."]</p><p>@Text["If you offer a modified version over a network, the license requires making the corresponding source available to its users."]</p><a class="text-link" href="@(repository + "#docker-compose-deployment")" target="_blank" rel="noopener noreferrer">@Text["Self-hosting guide ↗"]</a><a class="license-link" href="@(repository + "/blob/main/LICENSE")" target="_blank" rel="noopener noreferrer">@Text["Read the license ↗"]</a></article>
            </div>
        </section>
        <section class="mobile-section shell" aria-labelledby="mobile-title"><div><p class="eyebrow">@Text["A LITTLE FURTHER DOWN THE ROAD"]</p><h2 id="mobile-title">@Text["In your pocket, too."]</h2><p>@Text["Native mobile apps are on the horizon."]</p></div><div class="platforms"><div><span>@Text["Android application"]</span><span class="pill">@Text["Coming soon"]</span></div><div><span>@Text["iOS application"]</span><span class="pill">@Text["Coming soon"]</span></div></div></section>
    </main>
    <footer class="shell footer"><a class="brand" href="#"><img src="/images/logo.png" width="28" height="28" alt="" />PocketLedger</a><a href="/privacy">@Text["Privacy"]</a><a href="/contact">@Text["Contact"]</a><p>@Text["Made by"] <a href="https://www.linkedin.com/in/%C3%A1d%C3%A1m-kert%C3%A9sz-b6a541149/" target="_blank" rel="noopener noreferrer">Ádám Kertész</a></p><a class="github-link" href="@repository" target="_blank" rel="noopener noreferrer"><svg class="github-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href="#github-mark"></use></svg>GitHub ↗</a><span>AGPL-3.0-only</span></footer>
    <dialog class="image-viewer" aria-label="@Text["PocketLedger screenshots"]">
        <div class="viewer-toolbar">
            <p id="viewer-caption" aria-live="polite"></p>
            <button type="button" data-viewer-zoom aria-pressed="false">@Text["Zoom in"]</button>
            <button type="button" data-viewer-close autofocus aria-label="@Text["Close image viewer"]">@Text["Close ×"]</button>
        </div>
        <div class="viewer-image"><img alt="" /></div>
        <div class="viewer-navigation">
            <button type="button" data-viewer-previous aria-label="@Text["Previous screenshot"]">@Text["← Previous"]</button>
            <span data-viewer-position></span>
            <button type="button" data-viewer-next aria-label="@Text["Next screenshot"]">@Text["Next →"]</button>
        </div>
    </dialog>
</body>
</html>
