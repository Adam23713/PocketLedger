@page "/"
@inject IConfiguration Configuration
@{
    var appUrl = Configuration["Landing:AppBaseUrl"]!;
    const string repository = "https://github.com/Adam23713/PocketLedger";
    var screenshots = new[] {
        ("trs", "Income, expenses & transfers", "Follow the everyday movement of your money.", 1340, 796),
        ("statics", "See where it all goes", "Explore your spending and income with clear statistics.", 1355, 798),
        ("calendar", "Your finances, on a calendar", "See your financial activity across the month.", 1358, 812),
        ("loans", "Keep track of loans & debts", "Know what you owe and what is owed to you.", 1360, 793),
        ("recurring", "Make room for the recurring", "Keep regular income and expenses in view.", 1342, 553),
        ("categories", "A place for every transaction", "Organize your finances with your own categories.", 1348, 656),
        ("settings", "Make PocketLedger yours", "Choose your appearance, currencies and preferences.", 1329, 946)
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="PocketLedger is a free, open-source personal finance app for tracking accounts, spending, income and debts. Use the hosted instance or run it on your own server." />
    <meta name="color-scheme" content="light dark" />
    <title>PocketLedger — Your money, a clearer picture</title>
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="stylesheet" href="/site.css" />
    <script src="/site.js" defer></script>
</head>
<body data-app-url="@appUrl">
    <svg class="icon-definitions" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="0" height="0">
        <symbol id="github-mark" viewBox="0 0 24 24">
            <path fill="currentColor" d="M12 .297C5.37.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.333-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23A11.5 11.5 0 0 1 12 6.1c1.02.005 2.045.138 3.003.403 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </symbol>
    </svg>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="development"><span class="status-dot" aria-hidden="true"></span> PocketLedger is under active development. Features and availability may change.</div>
    <header class="header">
        <nav class="shell nav" aria-label="Main navigation">
            <a class="brand" href="#"><img src="/images/logo.png" width="34" height="34" alt="" />PocketLedger</a>
            <div class="nav-links"><a href="#features">Features</a><a href="#open-source">Open source</a><a href="#self-hosting">Self-hosting</a><a class="github-link" href="@repository" target="_blank" rel="noopener noreferrer"><svg class="github-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href="#github-mark"></use></svg>GitHub ↗</a></div>
            <a class="button button-login button-small" data-app-link href="@(appUrl + "/Session/Login")"><span data-app-label>Log in</span><span class="login-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h5a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-5M4 12h11m-4-4 4 4-4 4" /></svg></span></a>
        </nav>
    </header>
    <main id="main">
        <section class="hero shell" aria-labelledby="hero-title">
            <div class="eyebrow"><span class="status-dot" aria-hidden="true"></span> PERSONAL FINANCE. FREE & OPEN SOURCE.</div>
            <h1 id="hero-title">Your money.<br /><span>A clearer picture.</span></h1>
            <p class="hero-copy">A little more clarity for your everyday finances. Track your accounts, spending and plans in one place — with an app you can make your own.</p>
            <div class="actions"><a class="button button-login" data-app-link href="@(appUrl + "/Session/Login")"><span data-app-label>Log in</span><span class="login-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h5a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-5M4 12h11m-4-4 4 4-4 4" /></svg></span></a><a class="button button-github github-link" href="@repository" target="_blank" rel="noopener noreferrer"><svg class="github-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href="#github-mark"></use></svg>Explore on GitHub <span aria-hidden="true">↗</span></a></div>
            <p class="hero-note">Free to use. Built for my own finances. Shared for yours.</p>
            <figure class="hero-image">
                <a href="/images/landing_page.webp" data-gallery-image aria-label="View PocketLedger dashboard and themes">
                    <img src="/images/landing_page.webp" srcset="/images/landing_page-small.webp 800w, /images/landing_page.webp 1672w" sizes="(max-width: 1200px) 94vw, 1180px" width="1672" height="941" fetchpriority="high" alt="PocketLedger dashboard showing account balances, recent transactions and three different appearance themes" />
                </a>
                <figcaption><span>ONE APP. YOUR CHOICE OF THEME.</span><span>Explore the details ↗</span></figcaption>
            </figure>
        </section>
        <section class="section shell" id="features" aria-labelledby="features-title">
            <div class="section-heading"><div><p class="eyebrow">THE EVERYDAY ESSENTIALS</p><h2 id="features-title">Less guesswork.<br />More understanding.</h2></div><p>From your morning coffee to the bigger picture, keep the details together and the overview clear.</p></div>
            <div class="features">
                <article><span class="feature-number">01 / ORGANIZE</span><h3>Every account, in view</h3><p>Bring accounts, income, expenses and transfers into one overview. Use categories to give every transaction a place.</p></article>
                <article><span class="feature-number">02 / UNDERSTAND</span><h3>See the bigger picture</h3><p>Explore statistics, follow your calendar and track recurring transactions, loans and debts.</p></article>
                <article><span class="feature-number">03 / MAKE IT YOURS</span><h3>Your money, your setup</h3><p>Work with multiple currencies, choose from multiple themes and keep your data portable with backup, import and export.</p></article>
            </div>
            <div class="gallery">
                @foreach (var shot in screenshots)
                {
                    <figure class="screenshot">
                        <a href="/images/@(shot.Item1).webp" data-gallery-image aria-label="@(shot.Item2 + " — view screenshot")">
                            <img src="/images/@(shot.Item1).webp" srcset="/images/@(shot.Item1)-small.webp 800w, /images/@(shot.Item1).webp @(shot.Item4)w" sizes="(max-width: 720px) 94vw, (max-width: 1200px) 46vw, 574px" width="@shot.Item4" height="@shot.Item5" loading="lazy" decoding="async" alt="@shot.Item2 — PocketLedger application screenshot" />
                        </a>
                        <figcaption><h3>@shot.Item2 <span aria-hidden="true">↗</span></h3><p>@shot.Item3</p></figcaption>
                    </figure>
                }
            </div>
        </section>
        <section class="story section" id="open-source" aria-labelledby="story-title">
            <div class="shell story-grid"><div><p class="eyebrow">A PERSONAL PROJECT, SHARED OPENLY</p><h2 id="story-title">Made for me.<br />Open to you.</h2></div><div class="story-copy"><p>I started PocketLedger because I wanted a simple, clear way to keep track of my own money — accounts, expenses, income and everything in between — with a setup under my own control.</p><p>It began as something for me. I’m sharing it because it might be useful to you, too. This is a personal open-source project, shaped by real everyday use.</p><a class="text-link github-link" href="@repository" target="_blank" rel="noopener noreferrer"><svg class="github-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href="#github-mark"></use></svg>Take a look at the source <span aria-hidden="true">↗</span></a></div></div>
        </section>
        <section class="section shell" id="self-hosting" aria-labelledby="hosting-title">
            <p class="eyebrow">CHOOSE WHAT WORKS FOR YOU</p><h2 id="hosting-title">A home for your finances.</h2>
            <div class="hosting-grid">
                <article class="hosting-card"><span class="pill">FREE HOSTED POCKETLEDGER</span><h3>Let me take care<br />of the hosting.</h3><p>I run a PocketLedger instance that is currently free to use. I cover the server costs myself, so account availability is limited and accounts are currently managed manually.</p><p>Capacity may grow over time. Already have an account? You can sign in below.</p><a class="button button-login" data-app-link href="@(appUrl + "/Session/Login")"><span data-app-label>Log in</span><span class="login-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h5a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-5M4 12h11m-4-4 4 4-4 4" /></svg></span></a></article>
                <article class="hosting-card self-host"><span class="pill">SELF-HOSTED · AGPL-3.0-ONLY</span><h3>Your server.<br />Your own instance.</h3><p>Run PocketLedger on your own server, fork it and change it to suit your needs under the AGPL-3.0-only license. You don’t have to use my hosted instance.</p><p>If you offer a modified version over a network, the license requires making the corresponding source available to its users.</p><a class="text-link" href="@(repository + "#docker-compose-deployment")" target="_blank" rel="noopener noreferrer">Self-hosting guide ↗</a><a class="license-link" href="@(repository + "/blob/main/LICENSE")" target="_blank" rel="noopener noreferrer">Read the license ↗</a></article>
            </div>
        </section>
        <section class="mobile-section shell" aria-labelledby="mobile-title"><div><p class="eyebrow">A LITTLE FURTHER DOWN THE ROAD</p><h2 id="mobile-title">In your pocket, too.</h2><p>Native mobile apps are on the horizon.</p></div><div class="platforms"><div><span>Android application</span><span class="pill">Coming soon</span></div><div><span>iOS application</span><span class="pill">Coming soon</span></div></div></section>
    </main>
    <footer class="shell footer"><a class="brand" href="#"><img src="/images/logo.png" width="28" height="28" alt="" />PocketLedger</a><p>Made by <a href="https://www.linkedin.com/in/%C3%A1d%C3%A1m-kert%C3%A9sz-b6a541149/" target="_blank" rel="noopener noreferrer">Ádám Kertész</a></p><a class="github-link" href="@repository" target="_blank" rel="noopener noreferrer"><svg class="github-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href="#github-mark"></use></svg>GitHub ↗</a><span>AGPL-3.0-only</span></footer>
    <dialog class="image-viewer" aria-label="PocketLedger screenshots">
        <div class="viewer-toolbar">
            <p id="viewer-caption" aria-live="polite"></p>
            <button type="button" data-viewer-zoom aria-pressed="false">Zoom in</button>
            <button type="button" data-viewer-close autofocus aria-label="Close image viewer">Close ×</button>
        </div>
        <div class="viewer-image"><img alt="" /></div>
        <div class="viewer-navigation">
            <button type="button" data-viewer-previous aria-label="Previous screenshot">← Previous</button>
            <span data-viewer-position></span>
            <button type="button" data-viewer-next aria-label="Next screenshot">Next →</button>
        </div>
    </dialog>
</body>
</html>
