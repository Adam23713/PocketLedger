@inject IConfiguration Configuration
@{
    var appUrl = Configuration["Landing:AppBaseUrl"]!;
    const string repository = "https://github.com/Adam23713/PocketLedger";
    const string contactEmail = "privacy@pocketledger.dev";
}
<!DOCTYPE html>
