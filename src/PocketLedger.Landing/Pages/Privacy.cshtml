@page "/privacy"
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Text
@inject IConfiguration Configuration
@inject PocketLedger.Landing.IRegistrationStatusProvider RegistrationStatusProvider
@{
    var appUrl = Configuration["Landing:AppBaseUrl"]!;
    var registration = await RegistrationStatusProvider.GetAsync(HttpContext.RequestAborted);
    ViewData["AppUrl"] = appUrl;
    const string repository = "https://github.com/Adam23713/PocketLedger";
    const string contactEmail = "privacy@pocketledger.dev";
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="How PocketLedger collects, uses, protects and lets you delete your personal and financial data, and your rights under the GDPR." />
    <meta name="color-scheme" content="dark" />
    <title>@Text["Privacy Policy — PocketLedger"]</title>
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="stylesheet" href="/site.css" asp-append-version="true" />
    <script src="/site.js" asp-append-version="true" defer></script>
</head>
<body data-fit-screen="@Text["Fit to screen"]" data-zoom-in="@Text["Zoom in"]" data-app-url="@appUrl">
    <svg class="icon-definitions" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="0" height="0">
        <symbol id="github-mark" viewBox="0 0 24 24">
            <path fill="currentColor" d="M12 .297C5.37.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.333-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23A11.5 11.5 0 0 1 12 6.1c1.02.005 2.045.138 3.003.403 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </symbol>
    </svg>
    <a class="skip-link" href="#main">@Text["Skip to content"]</a>
    @await Html.PartialAsync("_DevelopmentBanner", registration)
    @await Html.PartialAsync("_Header", "privacy")
    <main id="main">
        <section class="legal shell" aria-labelledby="legal-title">
            <p class="eyebrow">@Text["LEGAL"]</p>
            <h1 id="legal-title">@Text["Privacy Policy"]</h1>
            <p class="updated">@Text["Effective date: 5 November 2026 · Applies to pocketledger.dev and the PocketLedger application"]</p>
            <p class="legal-intro">@Text["This notice explains, in plain language, what personal data PocketLedger collects when you use our hosted service at"] <strong>pocketledger.dev</strong>@Text[", why we collect it, who we share it with, and the rights you have over it under the EU General Data Protection Regulation (GDPR). It does not apply to an instance of PocketLedger that you or someone else self-hosts — the operator of that instance is responsible for its own privacy notice."]</p>

            <nav class="legal-toc" aria-label="@Text["Table of contents"]">
                <h2>@Text["On this page"]</h2>
                <ol>
                    <li><a href="#who-we-are">@Text["Who we are"]</a></li>
                    <li><a href="#data-we-collect">@Text["What data we collect"]</a></li>
                    <li><a href="#why-we-use-it">@Text["Why we use it, and on what legal basis"]</a></li>
                    <li><a href="#who-we-share-it-with">@Text["Who we share it with"]</a></li>
                    <li><a href="#international-transfers">@Text["International data transfers"]</a></li>
                    <li><a href="#how-long-we-keep-it">@Text["How long we keep it"]</a></li>
                    <li><a href="#how-we-protect-it">@Text["How we protect your data"]</a></li>
                    <li><a href="#cookies">@Text["Cookies"]</a></li>
                    <li><a href="#your-rights">@Text["Your rights, and how to use them"]</a></li>
                    <li><a href="#automated-decisions">@Text["Automated decision-making"]</a></li>
                    <li><a href="#children">@Text["Children"]</a></li>
                    <li><a href="#changes">@Text["Changes to this notice"]</a></li>
                    <li><a href="#contact">@Text["Contact us"]</a></li>
                </ol>
            </nav>

            <article class="legal-section" id="who-we-are">
                <h2>1. @Text["Who we are"]</h2>
                <p>@Text["PocketLedger is a personal project, not a registered company. The hosted service at pocketledger.dev is operated by"] <strong>Ádám Kertész</strong> @Text["(Hungary), who is the data controller responsible for your personal data under the GDPR for this purpose."]</p>
                <p>@Text["We have not appointed a Data Protection Officer: at our current size and the kind of data we process, one is not legally required. You can reach us directly using the contact details in"] <a href="#contact">@Text["section 13"]</a> @Text["for anything related to your data or this notice."]</p>
            </article>

            <article class="legal-section" id="data-we-collect">
                <h2>2. @Text["What data we collect"]</h2>
                <p>@Text["We only collect data that lets the Service work, keeps your account secure, or that you choose to give us."]</p>
                <table class="legal-table">
                    <thead><tr><th>@Text["Category"]</th><th>@Text["Examples"]</th><th>@Text["Where it comes from"]</th></tr></thead>
                    <tbody>
                        <tr><td>@Text["Account & authentication data"]</td><td>@Text["Username, email address, phone number (only if you choose to provide one), a one-way hash of your password (we never store it in plain text), your TOTP two-factor secret and recovery codes"]</td><td>@Text["You, when you register or manage your account"]</td></tr>
                        <tr><td>@Text["Social sign-in data"]</td><td>@Text["Only if you choose to sign in with Google, Facebook or GitHub: the provider's identifier for your account, your email address and whether the provider has verified it. We don't request your name, profile picture, contacts, friends list or any other profile data"]</td><td>@Text["Google, Meta (Facebook) or GitHub, when you choose to sign in with them"]</td></tr>
                        <tr><td>@Text["Financial data you enter"]</td><td>@Text["Accounts, transactions and their notes, categories, recurring entries, loans and debts, planner/budget entries, your display name, and preferences such as currency, timezone, icons and colours"]</td><td>@Text["You, directly, as you use the Service"]</td></tr>
                        <tr><td>@Text["Security & activity data"]</td><td>@Text["Sign-in timestamps and outcomes, the IP address and browser/device identifier (user agent) of your most recent successful login, and security audit events such as password or 2FA changes"]</td><td>@Text["Generated automatically as you use the Service"]</td></tr>
                        <tr><td>@Text["Technical & connection data"]</td><td>@Text["IP address, requested URL, timestamp and response status for each request to our servers"]</td><td>@Text["Generated automatically by our edge infrastructure for every request, including from visitors who are not registered users"]</td></tr>
                        <tr><td>@Text["Contact form messages"]</td><td>@Text["The email address you give us to reply to and the text of your message. The website itself does not store them: they are forwarded straight to our mailbox at our email provider (see"] <a href="#who-we-share-it-with">@Text["section 4"]</a>)</td><td>@Text["You, when you use the"] <a class="text-link" href="/contact">@Text["contact form"]</a></td></tr>
                        <tr><td>@Text["Backup files you create"]</td><td>@Text["An encrypted, password-protected export of your finance data, generated only if and when you use the Import/Export feature. It never includes your password, TOTP secret, recovery codes or session data"]</td><td>@Text["You, on request"]</td></tr>
                    </tbody>
                </table>
                <p>@Text["We do not ask for or knowingly collect bank account numbers, card numbers, or credentials for any outside financial institution — PocketLedger is a manual ledger, not a service that connects to your bank."]</p>
            </article>

            <article class="legal-section" id="why-we-use-it">
                <h2>3. @Text["Why we use it, and on what legal basis"]</h2>
                <table class="legal-table">
                    <thead><tr><th>@Text["Purpose"]</th><th>@Text["Legal basis (GDPR Art. 6)"]</th></tr></thead>
                    <tbody>
                        <tr><td>@Text["Creating and running your account; storing, showing and letting you import/export your financial data"]</td><td>@Text["Performance of a contract with you (Art. 6(1)(b))"]</td></tr>
                        <tr><td>@Text["Letting you sign in with Google, Facebook or GitHub, if you choose to"]</td><td>@Text["Performance of a contract with you (Art. 6(1)(b))"]</td></tr>
                        <tr><td>@Text["Keeping your account secure: two-factor authentication, recovery codes, sign-in auditing"]</td><td>@Text["Performance of a contract, and our legitimate interest in keeping accounts secure (Art. 6(1)(b) and (f))"]</td></tr>
                        <tr><td>@Text["Detecting and blocking abusive, fraudulent or high-volume traffic (rate limiting, automated ban rules)"]</td><td>@Text["Our legitimate interest in protecting the Service and its users from abuse (Art. 6(1)(f))"]</td></tr>
                        <tr><td>@Text["Responding when you contact us for support"]</td><td>@Text["Steps taken at your request, and our legitimate interest in providing support (Art. 6(1)(b) and (f))"]</td></tr>
                    </tbody>
                </table>
                <p>@Text["We do not use your data for advertising or behavioural profiling, we run no analytics or tracking on the Service, and we do not send marketing emails. If that ever changes, we will update this notice and ask for your consent wherever the law requires it, rather than relying on this notice to cover it retroactively."]</p>
            </article>

            <article class="legal-section" id="who-we-share-it-with">
                <h2>4. @Text["Who we share it with"]</h2>
                <p>@Text["We keep the list of parties who can see your data short and deliberately:"]</p>
                <ul>
                    <li><strong>@Text["Our hosting provider"]</strong>@Text[", who runs the physical servers your data is stored and processed on, located within the European Economic Area (EEA)."]</li>
                    <li><strong>Forpsi (BlazeArts Kft.)</strong>@Text[", our email provider, which hosts our mailboxes on servers within the EEA. Emails you send us — including messages from the"] <a class="text-link" href="/contact">@Text["contact form"]</a>@Text[", which is delivered through its mail servers — and our replies are stored there."]</li>
                    <li><strong>Cloudflare, Inc.</strong>@Text[", which sits in front of our servers to provide content delivery, DDoS protection and bot/abuse filtering. As part of this, Cloudflare sees connection-level metadata — such as your IP address and the host and path you're requesting — for every request to the Service. Cloudflare's data processing terms are built into its standard customer agreement; see"] <a class="text-link" href="https://www.cloudflare.com/trust-hub/gdpr/" target="_blank" rel="noopener noreferrer">@Text["Cloudflare's GDPR information ↗"]</a>@Text[". On the contact form, Cloudflare Turnstile checks that the message is sent by a person rather than a bot; to do so it evaluates signals from your browser for that page only, without setting advertising or tracking cookies."]</li>
                    <li><strong>Google LLC</strong>, <strong>Meta Platforms, Inc.</strong> @Text["(Facebook) and"] <strong>GitHub, Inc.</strong>@Text[", only if you choose to sign in with them. When you do, the provider learns that you signed in to PocketLedger, and sends us the limited data listed in"] <a href="#data-we-collect">@Text["section 2"]</a>@Text[". We never send them your financial data. Their own handling of your data is covered by"] <a class="text-link" href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">@Text["Google's Privacy Policy ↗"]</a>, <a class="text-link" href="https://www.facebook.com/privacy/policy/" target="_blank" rel="noopener noreferrer">@Text["Meta's Privacy Policy ↗"]</a> @Text["and"] <a class="text-link" href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener noreferrer">@Text["GitHub's Privacy Statement ↗"]</a>.</li>
                    <li><strong>Google LLC</strong> @Text["(YouTube), only if you choose to play the video on our home page. Until you click play, nothing is loaded from YouTube. Once you do, the video is loaded from YouTube's privacy-enhanced domain (youtube-nocookie.com), and YouTube receives your IP address and the technical details of your browser, and may store data in your browser, as described in"] <a class="text-link" href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">@Text["Google's Privacy Policy ↗"]</a>.</li>
                </ul>
                <p>@Text["Our automated abuse-detection system (CrowdSec) runs entirely on our own servers, and its optional community threat-sharing feature is switched off — it does not send your data anywhere outside our infrastructure."]</p>
                <p>@Text["Apart from the email provider above, we use no third-party email delivery service, and we have no analytics or advertising partners. We do not sell your data, rent it out, or share it with data brokers. We may disclose data where required by law, or to protect the rights, property or safety of PocketLedger, our users, or others."]</p>
            </article>

            <article class="legal-section" id="international-transfers">
                <h2>5. @Text["International data transfers"]</h2>
                <p>@Text["Your account and financial data is stored and primarily processed on servers located within the EEA. The transfers outside the EEA we're aware of are the connection-level metadata described above that necessarily passes through Cloudflare, Inc. as part of its edge and security service, only if you choose social sign-in, the sign-in exchange with Google LLC, Meta Platforms, Inc. or GitHub, Inc., and, only if you choose to play the home page video, the video request to Google LLC (YouTube). All of these companies are headquartered in the United States. These transfers rely on the EU–U.S. Data Privacy Framework, with Standard Contractual Clauses as a fallback safeguard where the Framework doesn't apply."]</p>
            </article>

            <article class="legal-section" id="how-long-we-keep-it">
                <h2>6. @Text["How long we keep it"]</h2>
                <p>@Text["When you delete your account, your account, authentication, and financial data is deleted immediately — we don't keep a separate retention window \"just in case.\" An encrypted backup you've exported yourself is yours to keep or delete; we don't retain a copy of it after you download it."]</p>
                <p>@Text["Contact form messages are kept in our mailbox only as long as needed to answer you and handle any follow-up, and you can ask us to delete them at any time."]</p>
                <h3 id="delete-account">@Text["How to delete your account"]</h3>
                <p>@Text["Sign in, open the profile menu, choose"] <strong>@Text["Account & security"]</strong>@Text[", then go to"] <strong>@Text["Account"]</strong> @Text["and use"] <strong>@Text["Delete account"]</strong>@Text[". Before you confirm, you can download an encrypted backup of your financial data. Deletion removes your account, your financial data, any connected Google or Facebook sign-in, your sign-in history and your encryption keys, and ends all of your active sessions. The only thing we keep is your account's random internal identifier and the time of deletion, with no name, email or other personal data attached, so that any session still open elsewhere is refused."]</p>
                <p>@Text["Deleting your PocketLedger account doesn't change anything in your Google, Facebook or GitHub account. To also remove PocketLedger from the apps connected there, use"] <a class="text-link" href="https://myaccount.google.com/connections" target="_blank" rel="noopener noreferrer">@Text["Google's third-party connections ↗"]</a>, <a class="text-link" href="https://www.facebook.com/settings/?tab=business_tools" target="_blank" rel="noopener noreferrer">@Text["Facebook's Apps and Websites settings ↗"]</a> @Text["or"] <a class="text-link" href="https://github.com/settings/applications" target="_blank" rel="noopener noreferrer">@Text["GitHub's Authorized OAuth Apps ↗"]</a>@Text[". If you can't sign in, contact us using the details in"] <a href="#contact">@Text["section 13"]</a> @Text["and we'll delete your account for you."]</p>
                <p>@Text["Raw technical access logs used for abuse detection are kept for a short, fixed window (currently up to seven days) and then automatically deleted; they are not linked to your account beyond that window."]</p>
                <p>@Text["The application also keeps short-lived security statistics for at most 48 hours, after which they expire automatically: request counts in five-minute intervals, broken down by account and by IP address; for each IP address, the request method, the path without its query string or record identifiers, the response status and the accounts seen from that address, in hourly groups; and the IP address of every request for a rolling three-minute window so unusually high request volumes can be detected. When an IP address exceeds that threshold, we record an incident containing the address, the accounts and the parts of the Service involved, the request count and the time, so the traffic can be reviewed and blocked if necessary. An IP address that an administrator bans from this data stays on the block list for the chosen period, at most 30 days."]</p>
                <div class="legal-note">@Text["If we ever perform routine technical backups of our servers for disaster-recovery purposes, these are rotated on a short cycle and are not used to restore data you've asked us to delete."]</div>
            </article>

            <article class="legal-section" id="how-we-protect-it">
                <h2>7. @Text["How we protect your data"]</h2>
                <p>@Text["PocketLedger is open source, so you don't have to take our word for this — you can read exactly how it's built:"]</p>
                <ul>
                    <li>@Text["Sensitive fields (transaction notes, account and category names, debts, your TOTP secret, recovery codes) are"] <strong>@Text["encrypted before they're ever written to the database"]</strong>@Text[", with no setting to turn this off and no plaintext fallback on error."]</li>
                    <li>@Text["Every account is protected by"] <strong>@Text["TOTP-based two-factor authentication"]</strong> @Text["and one-time recovery codes, including accounts that sign in with Google, Facebook or GitHub. When public registration is enabled, new users can create their own account."]</li>
                    <li>@Text["Your encryption key can only be unlocked with your PocketLedger password or your data recovery key. If you sign in with Google, Facebook or GitHub, you set a separate"] <strong>@Text["data password"]</strong> @Text["for this, so the social provider alone can never unlock your financial data."]</li>
                    <li>@Text["Traffic to the Service passes through a rate-limiting and automated-ban layer that blocks abusive or high-volume requests before they reach the application."]</li>
                    <li>@Text["Every internal connection between our services is itself encrypted with a private TLS certificate authority, independent of the public HTTPS connection your browser uses."]</li>
                </ul>
                <p>@Text["Full technical detail:"] <a class="text-link" href="@(repository + "/blob/main/docs/database-encryption.md")" target="_blank" rel="noopener noreferrer">@Text["database encryption ↗"]</a>, <a class="text-link" href="@(repository + "/blob/main/docs/oci-kms.md")" target="_blank" rel="noopener noreferrer">@Text["key management ↗"]</a>, <a class="text-link" href="@(repository + "/blob/main/docs/edge-security.md")" target="_blank" rel="noopener noreferrer">@Text["edge security ↗"]</a>.</p>
            </article>

            <article class="legal-section" id="cookies">
                <h2>8. @Text["Cookies"]</h2>
                <p>@Text["Signing in sets two cookies on the application domain: an encrypted session cookie that keeps you signed in, and an anti-forgery cookie that protects your account from cross-site request forgery. If you sign in with Google, Facebook or GitHub, short-lived cookies also protect that sign-in from tampering and are removed once it completes. All of these are strictly necessary for the Service to function, contain no advertising or tracking identifiers, and are not shared with any third party. Because they're strictly necessary, they don't require a cookie-consent banner under EU ePrivacy rules. Preference cookies remember the appearance theme, avatar and language you choose. They only store those choices. We set no analytics, advertising or tracking cookies."]</p>
                <p>@Text["The home page video is the only third-party content we embed, and it stays unloaded until you click play. After that, YouTube (Google LLC) may store data in your browser under its own policy; see"] <a href="#who-we-share-it-with">@Text["section 4"]</a>.</p>
            </article>

            <article class="legal-section" id="your-rights">
                <h2>9. @Text["Your rights, and how to use them"]</h2>
                <p>@Text["Under the GDPR, you have the right to:"]</p>
                <ul>
                    <li><strong>@Text["Access"]</strong> @Text["the personal data we hold about you."]</li>
                    <li><strong>@Text["Rectify"]</strong> @Text["inaccurate or incomplete data — most of this you can already edit directly in the app."]</li>
                    <li><strong>@Text["Erase"]</strong> @Text["your data (\"right to be forgotten\") by deleting your account — see"] <a href="#delete-account">@Text["How to delete your account"]</a>.</li>
                    <li><strong>@Text["Export your data"]</strong> @Text["in a portable format — use the built-in encrypted backup under Import/Export at any time; it covers your complete financial dataset."]</li>
                    <li><strong>@Text["Restrict or object"]</strong> @Text["to certain processing, in particular any processing based on our legitimate interest."]</li>
                    <li><strong>@Text["Withdraw consent"]</strong> @Text["at any time, for any processing that is ever based on consent (we currently have none)."]</li>
                    <li><strong>@Text["Lodge a complaint"]</strong> @Text["with a supervisory authority, including the one below or the one in your own country of residence within the EU/EEA."]</li>
                </ul>
                <p>@Text["To exercise any of these rights, contact us using the details in"] <a href="#contact">@Text["section 13"]</a>@Text[". We'll respond within one month, as required by the GDPR."]</p>
                <dl class="legal-contact">
                    <dt>@Text["Hungarian supervisory authority"]</dt>
                    <dd>Nemzeti Adatvédelmi és Információszabadság Hatóság (NAIH)</dd>
                    <dd>@Text["1055 Budapest, Falk Miksa utca 9-11, Hungary (postal: 1363 Budapest, Pf.: 9.)"]</dd>
                    <dd>ugyfelszolgalat@naih.hu · +36 (1) 391 1400 · <a class="text-link" href="https://www.naih.hu/" target="_blank" rel="noopener noreferrer">naih.hu ↗</a></dd>
                </dl>
            </article>

            <article class="legal-section" id="automated-decisions">
                <h2>10. @Text["Automated decision-making"]</h2>
                <p>@Text["PocketLedger automatically posts recurring transactions on the schedule you set up yourself — that's carrying out your own instructions, not a decision made about you. We do not use automated decision-making or profiling that produces legal or similarly significant effects on you."]</p>
            </article>

            <article class="legal-section" id="children">
                <h2>11. @Text["Children"]</h2>
                <p>@Text["The Service isn't directed at, and shouldn't be used by, anyone under the age of 16. We don't knowingly collect data from children. If you believe a child has provided us with personal data, contact us and we'll delete it."]</p>
            </article>

            <article class="legal-section" id="changes">
                <h2>12. @Text["Changes to this notice"]</h2>
                <p>@Text["We may update this notice as the Service changes. The effective date at the top always reflects the latest version. If a change is material, we'll make that clear on the Service itself, not just here."]</p>
            </article>

            <article class="legal-section" id="contact">
                <h2>13. @Text["Contact us"]</h2>
                <p>@Text["For anything about this notice or your personal data — access, correction, deletion, or just a question — reach out directly:"]</p>
                <dl class="legal-contact">
                    <dt>@Text["Data controller"]</dt>
                    <dd>@Text["Ádám Kertész, Hungary"]</dd>
                    <dt>@Text["Email"]</dt>
                    <dd><a class="text-link" href="mailto:@contactEmail">@contactEmail</a></dd>
                    <dt>@Text["Project"]</dt>
                    <dd><a class="text-link github-link" href="@repository" target="_blank" rel="noopener noreferrer"><svg class="github-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><use href="#github-mark"></use></svg>github.com/Adam23713/PocketLedger ↗</a></dd>
                </dl>
            </article>
        </section>
    </main>
    <footer class="shell footer"><a class="brand" href="/"><img src="/images/logo.png" width="28" height="28" alt="" />PocketLedger</a><a href="/privacy">@Text["Privacy"]</a><a href="/contact">@Text["Contact"]</a><p>@Text["Made by"] <a href="https://www.linkedin.com/in/%C3%A1d%C3%A1m-kert%C3%A9sz-b6a541149/" target="_blank" rel="noopener noreferrer">Ádám Kertész</a></p><a class="github-link" href="@repository" target="_blank" rel="noopener noreferrer"><svg class="github-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href="#github-mark"></use></svg>GitHub ↗</a><span>AGPL-3.0-only</span></footer>
    <dialog class="image-viewer" aria-label="@Text["PocketLedger screenshots"]">
        <div class="viewer-toolbar">
            <p id="viewer-caption" aria-live="polite"></p>
            <button type="button" data-viewer-zoom aria-pressed="false">@Text["Zoom in"]</button>
            <button type="button" data-viewer-close autofocus aria-label="@Text["Close image viewer"]">@Text["Close ×"]</button>
        </div>
        <div class="viewer-image"><img alt="" /></div>
        <div class="viewer-navigation">
            <button type="button" data-viewer-previous aria-label="@Text["Previous screenshot"]">@Text["← Previous"]</button>
            <span data-viewer-position></span>
            <button type="button" data-viewer-next aria-label="@Text["Next screenshot"]">@Text["Next →"]</button>
        </div>
    </dialog>
</body>
</html>
