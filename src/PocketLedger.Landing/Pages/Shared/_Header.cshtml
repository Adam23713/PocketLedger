@model string
@{
    // The model names the current page; section links point at the home page so the menu is identical everywhere.
    var appUrl = (string)ViewData["AppUrl"]!;
    const string repository = "https://github.com/Adam23713/PocketLedger";
    string? Current(string page) => Model == page ? "page" : null;
}
<header class="header">
    <nav class="shell nav" aria-label="Main navigation">
        <a class="brand" href="/"><img src="/images/logo.png" width="34" height="34" alt="" />PocketLedger</a>
        <div class="nav-links"><a href="/#features">Features</a><a href="/#security">Security</a><a href="/#open-source">Open source</a><a href="/#self-hosting">Self-hosting</a><a href="/contact" aria-current="@Current("contact")">Contact</a><a class="github-link" href="@repository" target="_blank" rel="noopener noreferrer"><svg class="github-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href="#github-mark"></use></svg>GitHub ↗</a></div>
        <a class="button button-login button-small" data-app-link href="@(appUrl + "/Session/Login")"><span data-app-label>Log in</span><span class="login-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h5a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-5M4 12h11m-4-4 4 4-4 4" /></svg></span></a>
    </nav>
</header>
