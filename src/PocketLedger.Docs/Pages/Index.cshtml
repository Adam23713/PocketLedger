@page "/"
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Text
@{
    ViewData["Title"] = Text["Documentation"].Value;
}
<section class="hero shell">
    <p class="eyebrow">@Text["Documentation"].Value.ToUpperInvariant()</p>
    <h1>@Text["Build confidence with PocketLedger."]</h1>
    <p class="lead">@Text["Learn how to use PocketLedger or integrate a client with its API. This documentation is being built alongside the project."]</p>
</section>

<section class="section shell" aria-labelledby="explore-title">
    <div class="section-heading">
        <p class="eyebrow">@Text["START HERE"]</p>
        <h2 id="explore-title">@Text["Explore the documentation"]</h2>
    </div>
    <div class="cards">
        <a class="card" asp-page="/Guide/Index">
            <span class="card-index">@Text["01 / GUIDE"]</span>
            <h3>@Text["User guide"]</h3>
            <p>@Text["Step-by-step help for setting up and using PocketLedger in everyday life."]</p>
            <span class="card-link">@Text["Open the guide"] <span aria-hidden="true">→</span></span>
        </a>
        <a class="card" asp-page="/Api/Index">
            <span class="card-index">02 / API</span>
            <h3>@Text["API reference"]</h3>
            <p>@Text["Concepts, endpoints and copyable curl examples for developers building PocketLedger clients."]</p>
            <span class="card-link">@Text["Explore the API"] <span aria-hidden="true">→</span></span>
        </a>
    </div>
</section>
