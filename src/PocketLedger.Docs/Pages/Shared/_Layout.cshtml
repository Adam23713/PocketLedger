@inject IConfiguration Configuration
@{
    var path = Context.Request.Path;
    var title = ViewData["Title"] as string;
    var landingUrl = Configuration["Docs:LandingBaseUrl"] ?? "https://pocketledger.dev";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Guides and API documentation for PocketLedger." />
    <meta name="color-scheme" content="dark" />
    <title>@(string.IsNullOrWhiteSpace(title) ? "PocketLedger Docs" : $"{title} — PocketLedger Docs")</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
    <script src="~/site.js" asp-append-version="true" defer></script>
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header">
        <nav class="shell nav" aria-label="Main navigation">
            <a class="brand" asp-page="/Index"><img src="~/images/logo.png" width="34" height="34" alt="" /><span>PocketLedger <strong>Docs</strong></span></a>
            <div class="nav-links">
                <a asp-page="/Guide/Index" aria-current="@(path.StartsWithSegments("/Guide") ? "page" : null)">Guide</a>
                <a asp-page="/Api/Index" aria-current="@(path.StartsWithSegments("/Api") ? "page" : null)">API</a>
                <a href="@landingUrl">PocketLedger</a>
                <a href="https://github.com/Adam23713/PocketLedger" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
            </div>
        </nav>
    </header>
    <main id="main">
        @RenderBody()
    </main>
    <footer class="shell footer">
        <span>PocketLedger documentation</span>
        <a href="@(landingUrl.TrimEnd('/'))/contact">Contact</a>
        <span>AGPL-3.0-only</span>
    </footer>
</body>
</html>
