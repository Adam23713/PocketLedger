@page "/guide/data-and-settings"
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Text
@{ ViewData["Title"] = Text["Data and settings"].Value; }
<div class="docs-layout shell">
    <partial name="_GuideNavigation" />
    <article class="docs-content guide-article">
        <p class="eyebrow">@Text["CHAPTER 06"]</p>
        <h1>@Text["Data & settings"]</h1>
        <p class="lead">@Text["Make the interface feel local, move transaction data in or out, and keep an encrypted copy of everything that matters."]</p>

        <h2 id="settings">@Text["Personalize PocketLedger"]</h2>
        <p>@Text["Open your avatar menu and choose"] <strong>@Text["Settings"]</strong>@Text[". Set a display name and avatar, choose your default currency and time zone, then configure how each currency should display decimal places, separators, symbols and spacing."]</p>
        <figure class="guide-figure">
            <img src="~/images/guide/settings.jpg" alt="@Text["Settings page with profile, avatar, default currency, time zone and currency formatting controls"]" />
            <figcaption>@Text["Formatting changes presentation only; stored monetary values remain unchanged."]</figcaption>
        </figure>

        <h2 id="import-export">@Text["Import, export and back up"]</h2>
        <figure class="guide-figure">
            <img src="~/images/guide/import-export.jpg" alt="@Text["Import and Export page with encrypted Excel export, CSV import, encrypted backup and restore actions"]" />
            <figcaption>@Text["Transaction exchange and full-database backup serve different purposes."]</figcaption>
        </figure>
        <div class="guide-feature-list">
            <div><strong>@Text["Excel export"]</strong><p>@Text["Downloads filtered transactions as a password-protected workbook."]</p></div>
            <div><strong>@Text["CSV import"]</strong><p>@Text["Previews bank-exported rows and imports only entries that pass validation."]</p></div>
            <div><strong>@Text["Encrypted backup"]</strong><p>@Text["Creates a password-protected copy of all PocketLedger financial data."]</p></div>
            <div><strong>@Text["Restore"]</strong><p>@Text["Previews an encrypted backup, then replaces the signed-in user’s current finance data after explicit confirmation."]</p></div>
        </div>
        <div class="guide-callout warning"><strong>@Text["Backup passwords cannot be recovered."]</strong><p>@Text["Use a unique password and store it separately from the backup file. Restoring replaces current finance data, so review the preview before confirming."]</p></div>

        <h2 id="security">@Text["Manage account security"]</h2>
        <p>@Text["Choose"] <strong>@Text["Account & security"]</strong> @Text["from the avatar menu to manage password access, authenticator settings, recovery material, login events and active security options. Never share QR codes, one-time codes, recovery codes or the data recovery key."]</p>

        <h2 id="workflow">@Text["A practical routine"]</h2>
        <ol class="guide-steps">
            <li><span>1</span><div><strong>@Text["During the week"]</strong><p>@Text["Record activity and check recurring entries."]</p></div></li>
            <li><span>2</span><div><strong>@Text["At month end"]</strong><p>@Text["Review Transactions, Calendar and Statistics for missing or unusual entries."]</p></div></li>
            <li><span>3</span><div><strong>@Text["Before the next month"]</strong><p>@Text["Update the Monthly planner, debts and goals."]</p></div></li>
            <li><span>4</span><div><strong>@Text["Regularly"]</strong><p>@Text["Create an encrypted backup and verify that you still have its password."]</p></div></li>
        </ol>
        <nav class="chapter-pager" aria-label="@Text["Chapter navigation"]"><a asp-page="/Guide/DebtsAndGoals"><span aria-hidden="true">←</span> @Text["Debts & goals"]</a><a asp-page="/Guide/Index">@Text["Back to overview"] <span aria-hidden="true">↑</span></a></nav>
    </article>
</div>
