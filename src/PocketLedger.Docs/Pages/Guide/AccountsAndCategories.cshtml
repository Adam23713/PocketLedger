@page "/guide/accounts-and-categories"
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Text
@{ ViewData["Title"] = Text["Accounts and categories"].Value; }
<div class="docs-layout shell">
    <partial name="_GuideNavigation" />
    <article class="docs-content guide-article">
        <p class="eyebrow">@Text["CHAPTER 02"]</p>
        <h1>@Text["Accounts & categories"]</h1>
        <p class="lead">@Text["Accounts hold balances. Categories explain where money came from or where it went. Set up both before entering day-to-day activity."]</p>

        <h2 id="accounts">@Text["Create an account"]</h2>
        <p>@Text["Open your avatar menu, choose"] <strong>@Text["Accounts"]</strong>@Text[", then select"] <strong>@Text["New account"]</strong>@Text[". Give it a clear name, choose its type and currency, and enter the opening balance as of the selected date."]</p>
        <figure class="guide-figure">
            <img src="~/images/guide/account-form.jpg" alt="@Text["New account form with name, type, currency, opening balance and account display options"]" />
            <figcaption>@Text["The reporting switches decide where an account contributes; they do not change its real balance."]</figcaption>
        </figure>
        <div class="guide-feature-list">
            <div><strong>@Text["Main balance"]</strong><p>@Text["Includes the account in the headline balance used across the app."]</p></div>
            <div><strong>@Text["Net worth"]</strong><p>@Text["Includes the account in the dashboard net-worth figure."]</p></div>
            <div><strong>@Text["Statistics"]</strong><p>@Text["Allows activity on the account to contribute to reports."]</p></div>
            <div><strong>@Text["Display order"]</strong><p>@Text["Controls where the account appears in lists and on the dashboard."]</p></div>
        </div>

        <h2 id="account-list">@Text["Manage account balances"]</h2>
        <figure class="guide-figure">
            <img src="~/images/guide/accounts.jpg" alt="@Text["Accounts list with bank, credit card, savings and cash accounts in multiple currencies"]" />
            <figcaption>@Text["Each currency keeps its own balance; PocketLedger does not silently convert amounts between currencies."]</figcaption>
        </figure>
        <p>@Text["Select an account name to open its balance history, recent transactions and quick actions. Use"] <strong>@Text["Edit"]</strong> @Text["to change presentation and reporting options. Deletion is available only when related financial data does not make it unsafe."]</p>
        <figure class="guide-figure">
            <img src="~/images/guide/account-details.jpg" alt="@Text["Account details with current balance, account properties and recent transactions"]" />
            <figcaption>@Text["Account details connect the current balance to the entries that produced it."]</figcaption>
        </figure>

        <h2 id="categories">@Text["Organize with categories"]</h2>
        <p>@Text["Open"] <strong>@Text["Categories"]</strong> @Text["from the avatar menu. Income and expense categories are separate. Add a main category for a broad purpose, then use subcategories when you need more detail."]</p>
        <figure class="guide-figure">
            <img src="~/images/guide/categories.jpg" alt="@Text["Income and expense category trees with icons and nested subcategories"]" />
            <figcaption>@Text["A compact tree keeps transaction entry fast while preserving meaningful reporting detail."]</figcaption>
        </figure>
        <div class="guide-callout tip"><strong>@Text["Start broad."]</strong><p>@Text["A short category list is easier to use consistently. Add subcategories only when the distinction will help a decision or report."]</p></div>
        <nav class="chapter-pager" aria-label="@Text["Chapter navigation"]"><a asp-page="/Guide/GettingStarted"><span aria-hidden="true">←</span> @Text["Getting started"]</a><a asp-page="/Guide/Transactions">@Text["Transactions"] <span aria-hidden="true">→</span></a></nav>
    </article>
</div>
