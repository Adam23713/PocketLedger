@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Text
@{
    var path = Context.Request.Path.Value ?? string.Empty;
    string? Current(string target) => path.Equals(target, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
<aside class="sidebar guide-sidebar" aria-label="@Text["User guide navigation"]">
    <p class="sidebar-title">@Text["User guide"]</p>
    <a asp-page="/Guide/Index" aria-current="@Current("/guide")">@Text["Overview"]</a>
    <a asp-page="/Guide/GettingStarted" aria-current="@Current("/guide/getting-started")">@Text["Getting started"]</a>
    <a asp-page="/Guide/AccountsAndCategories" aria-current="@Current("/guide/accounts-and-categories")">@Text["Accounts & categories"]</a>
    <a asp-page="/Guide/Transactions" aria-current="@Current("/guide/transactions")">@Text["Transactions"]</a>
    <a asp-page="/Guide/Planning" aria-current="@Current("/guide/planning")">@Text["Planning & insights"]</a>
    <a asp-page="/Guide/DebtsAndGoals" aria-current="@Current("/guide/debts-and-goals")">@Text["Debts & goals"]</a>
    <a asp-page="/Guide/DataAndSettings" aria-current="@Current("/guide/data-and-settings")">@Text["Data & settings"]</a>
</aside>
