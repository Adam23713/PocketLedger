@page "/guide/planning"
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Text
@{ ViewData["Title"] = Text["Planning and insights"].Value; }
<div class="docs-layout shell">
    <partial name="_GuideNavigation" />
    <article class="docs-content guide-article">
        <p class="eyebrow">@Text["CHAPTER 04"]</p>
        <h1>@Text["Planning & insights"]</h1>
        <p class="lead">@Text["Turn repeated activity into automation, then use calendar, statistics and the monthly planner to understand what happened and what comes next."]</p>

        <h2 id="recurring">@Text["Automate repeating entries"]</h2>
        <p>@Text["Create a recurring template for salaries, subscriptions, rent and other predictable items. Choose the account, category, amount, frequency and next date. Active templates generate transactions according to their schedule."]</p>
        <figure class="guide-figure">
            <img src="~/images/guide/recurring-form.jpg" alt="@Text["Recurring transaction form with type, account, amount, category, schedule and note"]" />
            <figcaption>@Text["A recurring template describes future activity; generated transactions remain visible in the normal history."]</figcaption>
        </figure>
        <figure class="guide-figure">
            <img src="~/images/guide/recurring.jpg" alt="@Text["Recurring transaction list showing income, expenses and a loan-related recurring payment"]" />
            <figcaption>@Text["The list separates editable templates from loan-related schedules managed by the debt feature."]</figcaption>
        </figure>

        <h2 id="calendar">@Text["Read the calendar"]</h2>
        <p>@Text["Choose a month and currency to see daily income, expenses and running totals. Summary cards at the top highlight the month’s overall movement."]</p>
        <figure class="guide-figure">
            <img src="~/images/guide/calendar.jpg" alt="@Text["Monthly calendar with daily income, expense and running balance information"]" />
            <figcaption>@Text["Calendar is ideal for spotting clusters, timing effects and unusually expensive days."]</figcaption>
        </figure>

        <h2 id="statistics">@Text["Understand the patterns"]</h2>
        <p>@Text["Statistics combines monthly totals, category distribution, recurring expenses, account balances and longer-term trends. Select the same month and currency you want to compare elsewhere."]</p>
        <figure class="guide-figure">
            <img src="~/images/guide/statistics.jpg" alt="@Text["Statistics dashboard with income, expenses, balance and category distribution charts"]" />
            <figcaption>@Text["Main-category charts reveal the broad shape of spending before you drill into subcategories."]</figcaption>
        </figure>

        <h2 id="planner">@Text["Plan a future month"]</h2>
        <p>@Text["The Monthly planner combines planned income, expenses and transfers with active recurring entries and expected loan payments. Add items for the selected month, pause optional plans, and adjust opening balances when planning from a different starting point."]</p>
        <figure class="guide-figure">
            <img src="~/images/guide/planner.jpg" alt="@Text["Monthly planner with expected totals, planned items and projected balances for several currencies"]" />
            <figcaption>@Text["Each currency is calculated separately. Accounts marked Include contribute to the available-to-spend total."]</figcaption>
        </figure>
        <div class="guide-callout tip"><strong>@Text["Plans are estimates, not posted transactions."]</strong><p>@Text["Use the planner to test a future month. Record the real event as a transaction when it actually happens."]</p></div>
        <nav class="chapter-pager" aria-label="@Text["Chapter navigation"]"><a asp-page="/Guide/Transactions"><span aria-hidden="true">←</span> @Text["Transactions"]</a><a asp-page="/Guide/DebtsAndGoals">@Text["Debts & goals"] <span aria-hidden="true">→</span></a></nav>
    </article>
</div>
