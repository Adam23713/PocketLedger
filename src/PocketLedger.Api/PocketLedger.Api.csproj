      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.4" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PocketLedger.Application/PocketLedger.Application.csproj" />
    <ProjectReference Include="../PocketLedger.Contracts/PocketLedger.Contracts.csproj" />
    <ProjectReference Include="../PocketLedger.Domain/PocketLedger.Domain.csproj" />
