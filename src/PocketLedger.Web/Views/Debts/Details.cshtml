@model PocketLedger.Models.ViewModels.Debts.DebtDetailsViewModel
@using PocketLedger.Models.Enums
@{ ViewData["Title"] = Model.Summary.Name; }
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div class="d-flex align-items-center gap-3"><img class="category-icon" src="@Model.Summary.IconPath" alt="@Model.Summary.IconAlt" /><div><h1 class="mb-0">@Model.Summary.Name</h1><p class="text-muted mb-0">@Model.Summary.Direction · @Model.Summary.Type · @Model.CounterpartyName</p></div></div><div><a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Summary.Id">Edit</a> @if (Model.Summary.Status == DebtStatus.Active) { <a class="btn btn-primary" asp-action="AddOperation" asp-route-id="@Model.Summary.Id">New operation</a> } </div></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card card-body"><small>Original</small><strong>@MoneyFormatter.Format(Model.Summary.OriginalAmount, Model.Summary.Currency)</strong></div></div><div class="col-md-3"><div class="card card-body"><small>Remaining</small><strong>@MoneyFormatter.Format(Model.Summary.RemainingAmount, Model.Summary.Currency)</strong></div></div><div class="col-md-3"><div class="card card-body"><small>Next payment</small><strong>@(Model.Summary.NextPayment?.ToString("yyyy-MM-dd") ?? "—")</strong></div></div><div class="col-md-3"><div class="card card-body"><small>Status</small><strong>@Model.Summary.Status</strong></div></div></div>
<div class="mb-4"><div class="d-flex justify-content-between"><span>Paid: @MoneyFormatter.Format(Model.Summary.PaidAmount, Model.Summary.Currency)</span><span>@Model.Summary.ProgressPercentage.ToString("0.#")%</span></div><div class="progress" role="progressbar" aria-valuenow="@Model.Summary.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width: @Model.Summary.ProgressPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%">@Model.Summary.ProgressPercentage.ToString("0.#")%</div></div></div>
<dl class="row"><dt class="col-sm-3">Start / due</dt><dd class="col-sm-9">@Model.StartDate.ToString("yyyy-MM-dd") / @(Model.DueDate?.ToString("yyyy-MM-dd") ?? "no due date")</dd><dt class="col-sm-3">Linked account</dt><dd class="col-sm-9">@(Model.Summary.AccountName ?? "—")</dd><dt class="col-sm-3">Automatic payment</dt><dd class="col-sm-9">@(Model.AutomaticPaymentAmount is null ? "Disabled" : $"{MoneyFormatter.Format(Model.AutomaticPaymentAmount.Value, Model.Summary.Currency)} · {Model.Frequency}")</dd><dt class="col-sm-3">Note</dt><dd class="col-sm-9">@(Model.Note ?? "—")</dd></dl>
@if (Model.Summary.Status == DebtStatus.Closed) { <form asp-action="Reopen" asp-route-id="@Model.Summary.Id" method="post"><button class="btn btn-outline-primary">Reopen</button></form> } else if (Model.Summary.RemainingAmount == 0) { <form asp-action="Close" asp-route-id="@Model.Summary.Id" method="post"><button class="btn btn-outline-secondary">Close</button></form> }
<h2 class="h4 mt-5">History</h2>@if (Model.Operations.Count == 0) { <p class="text-muted">No operations yet.</p> } else { <div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Operation</th><th>Account</th><th>Note</th><th class="text-end">Amount</th><th></th></tr></thead><tbody>@foreach (var item in Model.Operations) { <tr><td><a asp-controller="Transactions" asp-action="Details" asp-route-id="@item.Id">@item.Date.ToString("yyyy-MM-dd") @item.Time.ToString("HH:mm")</a></td><td>@item.Type</td><td>@(item.AccountName ?? "No account movement")</td><td>@(item.Note ?? "—")</td><td class="text-end">@MoneyFormatter.Format(item.Amount, Model.Summary.Currency)</td><td><a class="btn btn-sm btn-outline-secondary" asp-action="EditOperation" asp-route-id="@item.Id">Edit</a> <form class="d-inline" asp-action="DeleteOperation" method="post"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="debtId" value="@Model.Summary.Id" /><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></td></tr> }</tbody></table></div> }
