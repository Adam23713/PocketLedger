@using PocketLedger.Localization
@model PocketLedger.Models.ViewModels.Debts.DebtFormViewModel
@{ ViewData["Title"] = CommonText.Get("Edit debt"); }
<h1>@CommonText.Get("Edit debt")</h1><form method="post"><input asp-for="Id" type="hidden" />@await Html.PartialAsync("_Form", Model)<button class="btn btn-primary mt-4" type="submit">@CommonText.Get("Save")</button> <a class="btn btn-link mt-4" asp-action="Details" asp-route-id="@Model.Id">@CommonText.Get("Cancel")</a></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
