@model PocketLedger.Models.ViewModels.Debts.DebtDeleteViewModel
@{ ViewData["Title"] = "Delete debt"; }
<h1>Delete debt</h1>
<div class="alert alert-danger"><strong>This action cannot be undone.</strong> Deleting <strong>@Model.Name</strong> will permanently delete @Model.TransactionCount transaction(s) and @Model.RecurringTransactionCount recurring payment(s).</div>
@if (Model.AffectedAccountCount > 0)
{
    <div class="alert alert-warning">The deleted transactions affect @Model.AffectedAccountCount account(s). Their initial balances will be adjusted automatically so their current balances remain unchanged.</div>
}
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button class="btn btn-danger" type="submit">Delete debt and related transactions</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</form>
