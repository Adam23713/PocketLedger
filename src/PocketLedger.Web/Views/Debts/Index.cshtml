@using PocketLedger.Localization
@model PocketLedger.Models.ViewModels.Debts.DebtIndexViewModel
@{ ViewData["Title"] = CommonText.Get("Loans / Debts"); }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>@CommonText.Get("Loans / Debts")</h1><a class="btn btn-primary" asp-action="Create">@CommonText.Get("New debt")</a></div>
@foreach (var group in Model.ActiveGroups)
{
    <section class="mb-4"><h2 class="h4">@group.Currency debts</h2>@await Html.PartialAsync("_DebtList", group.Items)<div class="d-flex flex-wrap justify-content-end gap-4 mt-2 fw-semibold"><span>I owe: @MoneyFormatter.Format(group.WeOwe, group.Currency)</span><span>Owed to me: @MoneyFormatter.Format(group.OwedToUs, group.Currency)</span></div></section>
}
@if (Model.ActiveGroups.Count == 0) { <p class="text-muted">@CommonText.Get("No active debts.")</p> }
<h2 class="h4 mt-5">@CommonText.Get("Closed")</h2>
@foreach (var group in Model.ClosedGroups)
{
    <section class="mb-4"><h3 class="h5">@group.Currency debts</h3>@await Html.PartialAsync("_DebtList", group.Items)</section>
}
@if (Model.ClosedGroups.Count == 0) { <p class="text-muted">@CommonText.Get("No closed debts.")</p> }
