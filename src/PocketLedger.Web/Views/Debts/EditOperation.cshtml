@model PocketLedger.Models.ViewModels.Debts.DebtOperationFormViewModel
@using PocketLedger.Models.Enums
@{ ViewData["Title"] = "Edit debt operation"; var operations = Model.Direction == DebtDirection.Payable ? new[] { DebtOperationType.Payment, DebtOperationType.EarlyRepayment, DebtOperationType.Increase, DebtOperationType.ManualCorrectionIncrease, DebtOperationType.ManualCorrectionDecrease } : new[] { DebtOperationType.LoanDisbursement, DebtOperationType.ReceivedRepayment, DebtOperationType.Increase, DebtOperationType.ManualCorrectionIncrease, DebtOperationType.ManualCorrectionDecrease }; }
<h1>Edit debt operation</h1><form method="post"><input asp-for="TransactionId" type="hidden" /><input asp-for="DebtId" type="hidden" /><input asp-for="Direction" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label asp-for="Type" class="form-label"></label><select asp-for="Type" class="form-select">@foreach (var operation in operations) { <option value="@operation">@operation</option> }</select></div><div class="col-md-4"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" type="number" step="0.0001" /></div><div class="col-md-4"><label asp-for="Date" class="form-label"></label><input asp-for="Date" class="form-control" type="date" /></div><div class="col-md-6"><label asp-for="AccountId" class="form-label">Account</label><select asp-for="AccountId" class="form-select"><option value="">None</option>@foreach (var account in Model.Accounts) { <option value="@account.Id">@account.Name (@account.Currency)</option> }</select></div><div class="col-md-6"><label asp-for="Note" class="form-label"></label><input asp-for="Note" class="form-control" /></div></div>@if (Model.RequiresOverpaymentResolution) { <div class="alert alert-warning mt-4"><strong>The operation exceeds the remaining debt by @MoneyFormatter.Format(Model.OverpaymentDifference, Model.Currency).</strong><div class="mt-3 d-flex flex-wrap gap-2"><button class="btn btn-primary" type="submit" name="OverpaymentResolution" value="IncreaseOriginalAmount">Increase original amount by the difference</button><button class="btn btn-outline-secondary" type="submit" name="OverpaymentResolution" value="ClampOperation">Limit operation to the remaining debt</button></div></div> } else { <button class="btn btn-primary mt-4" type="submit">Save</button> } <a class="btn btn-link mt-4" asp-action="Details" asp-route-id="@Model.DebtId">Cancel</a></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
