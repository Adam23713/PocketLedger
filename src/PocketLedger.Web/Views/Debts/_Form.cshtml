@model PocketLedger.Models.ViewModels.Debts.DebtFormViewModel
@using PocketLedger.Models.Enums
<input asp-for="ExistingOriginalAmount" type="hidden" /><input asp-for="RemainingAmountForSchedule" type="hidden" />
<div asp-validation-summary="All" class="text-danger"></div>
@if (Model.Id != Guid.Empty)
{
    <div class="alert alert-warning" role="alert">
        Changing the original amount recalculates the remaining balance. Changing or disabling automatic payment affects future scheduled payments only; existing repayments are not changed.
    </div>
}
<div class="row g-3">
<div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="Direction" class="form-label"></label><select asp-for="Direction" asp-items="Html.GetEnumSelectList<DebtDirection>()" class="form-select"></select></div>
<div class="col-md-3"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<DebtType>()" class="form-select"></select></div>
<div class="col-md-6"><label asp-for="CounterpartyName" class="form-label"></label><input asp-for="CounterpartyName" class="form-control" /></div>
@{ var initialMoneyFormat = MoneyFormatter.GetMoneyInputFormat(Model.Currency); }
<div class="col-md-3"><label asp-for="OriginalAmount" class="form-label"></label><input asp-for="OriginalAmount" type="hidden" id="debt-original-amount" /><input class="form-control" id="debt-original-amount-display" type="text" inputmode="decimal" autocomplete="off" data-money-value="debt-original-amount" data-money-currency="debt-currency" data-decimal-places="@initialMoneyFormat.DecimalPlaces" data-decimal-separator="@initialMoneyFormat.DecimalSeparator" data-thousands-separator="@initialMoneyFormat.ThousandsSeparator" /><span asp-validation-for="OriginalAmount" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="Currency" class="form-label"></label>@if (Model.Id == Guid.Empty) { <input asp-for="Currency" type="hidden" id="debt-currency-value" /><select class="form-select" id="debt-currency">@foreach (var currency in Currencies.All) { var format = MoneyFormatter.GetMoneyInputFormat(currency.Code); <option value="@(currency.Code)" selected="@(currency.Code == Model.Currency)" data-decimal-places="@(format.DecimalPlaces)" data-decimal-separator="@(format.DecimalSeparator)" data-thousands-separator="@(format.ThousandsSeparator)">@(currency.Code) — @(currency.DisplayName)</option> }</select> } else { <input asp-for="Currency" type="hidden" /><input class="form-control" id="debt-currency" value="@Model.Currency" disabled /><div class="form-text">Currency cannot be changed after debt creation.</div> }<span asp-validation-for="Currency" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" class="form-control" type="date" /></div>
<div class="col-md-3"><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" class="form-control" type="date" /></div>
<div class="col-md-6"><label asp-for="AccountId" class="form-label">Linked/source account</label><select asp-for="AccountId" class="form-select"><option value="">None</option>@foreach (var account in Model.Accounts) { <option value="@account.Id">@account.Name (@account.Currency)</option> }</select></div>
<div class="col-12"><label asp-for="Note" class="form-label"></label><textarea asp-for="Note" class="form-control"></textarea></div>
</div>
<fieldset class="mt-4" id="debt-icon-picker">
    <legend class="form-label">Icon</legend>
    <div class="category-icon-groups">
        @foreach (var group in Model.AvailableIcons.GroupBy(icon => new { icon.Group, icon.GroupDisplayName, icon.CategoryType }))
        {
            <section class="category-icon-group">
                <h2 class="h6">@group.Key.GroupDisplayName</h2>
                <div class="account-icon-grid">
                    @foreach (var icon in group)
                    {
                        <label class="account-icon-option"><input asp-for="Icon" type="radio" value="@icon.Id" /><span class="account-icon-selection"><img src="@icon.WebPath" alt="@icon.DisplayName" /><span class="visually-hidden">@icon.DisplayName</span></span></label>
                    }
                </div>
            </section>
        }
    </div>
    <span asp-validation-for="Icon" class="text-danger"></span>
</fieldset>
<div class="form-check mt-4"><input asp-for="AutomaticPaymentEnabled" class="form-check-input" /><label asp-for="AutomaticPaymentEnabled" class="form-check-label">Enable automatic payment</label></div>
<div class="row g-3 mt-0"><div class="col-md-3"><label asp-for="AutomaticPaymentAmount" class="form-label"></label><input name="AutomaticPaymentAmount" type="hidden" id="automatic-payment-amount" value="@(Model.AutomaticPaymentAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture))" /><input class="form-control" id="automatic-payment-amount-display" type="text" inputmode="decimal" autocomplete="off" value="@(Model.AutomaticPaymentAmount is null ? null : MoneyFormatter.FormatNumber(Model.AutomaticPaymentAmount.Value, Model.Currency))" data-money-value="automatic-payment-amount" data-money-currency="debt-currency" data-decimal-places="@initialMoneyFormat.DecimalPlaces" data-decimal-separator="@initialMoneyFormat.DecimalSeparator" data-thousands-separator="@initialMoneyFormat.ThousandsSeparator" /><span asp-validation-for="AutomaticPaymentAmount" class="text-danger"></span></div><div class="col-md-3"><label asp-for="NextPaymentDate" class="form-label"></label><input asp-for="NextPaymentDate" class="form-control" type="date" /></div><div class="col-md-3"><label asp-for="LastPaymentDate" class="form-label"></label><input asp-for="LastPaymentDate" class="form-control" type="date" /></div><div class="col-md-3"><label asp-for="Frequency" class="form-label"></label><select asp-for="Frequency" asp-items="Html.GetEnumSelectList<RecurringFrequency>()" class="form-select"></select></div></div>
<script src="~/js/money-input.js" asp-append-version="true"></script>
<script>
(() => {
    const currency = document.getElementById("debt-currency"), currencyValue = document.getElementById("debt-currency-value");
    if (currencyValue) {
        currency.addEventListener("change", () => currencyValue.value = currency.value);
        currencyValue.value = currency.value;
    }
    const original = document.getElementById("debt-original-amount"), existing = Number(document.getElementById("ExistingOriginalAmount").value || 0), remaining = Number(document.getElementById("RemainingAmountForSchedule").value || 0);
    const amount = document.getElementById("automatic-payment-amount"), first = document.getElementById("NextPaymentDate"), last = document.getElementById("LastPaymentDate"), frequency = document.getElementById("Frequency");
    let generated = !last.value;
    function add(date, count) { const result = new Date(date + "T12:00:00"), day = result.getDate(); if (frequency.value === "0") result.setDate(day + count); else if (frequency.value === "1") result.setDate(day + count * 7); else if (frequency.value === "2") { result.setDate(1); result.setMonth(result.getMonth() + count); result.setDate(Math.min(day, new Date(result.getFullYear(), result.getMonth() + 1, 0).getDate())); } else { result.setDate(1); result.setFullYear(result.getFullYear() + count); result.setDate(Math.min(day, new Date(result.getFullYear(), result.getMonth() + 1, 0).getDate())); } return result.toISOString().slice(0, 10); }
    function update() { if (!generated || !first.value || Number(amount.value) <= 0) return; const base = existing ? remaining + Number(original.value) - existing : Number(original.value); if (base > 0) last.value = add(first.value, Math.ceil(base / Number(amount.value)) - 1); }
    last.addEventListener("input", () => generated = !last.value);
    for (const input of [original, amount, first, frequency]) input.addEventListener("change", update);
    update();
})();
</script>
