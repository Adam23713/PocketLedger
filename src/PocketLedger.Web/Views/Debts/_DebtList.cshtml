@using PocketLedger.Localization
@model IReadOnlyList<PocketLedger.Models.ViewModels.Debts.DebtListItemViewModel>
@if (Model.Count == 0) { <div class="alert alert-info">@CommonText.Get("No items.")</div> }
else { <div class="table-responsive edge-to-edge-table debt-table-surface"><table class="table align-middle"><thead><tr><th>@CommonText.Get("Name")</th><th>@CommonText.Get("Direction")</th><th>@CommonText.Get("Type")</th><th>@CommonText.Get("Account")</th><th>@CommonText.Get("Next payment")</th><th class="text-end">@CommonText.Get("Original")</th><th class="text-end">@CommonText.Get("Remaining")</th><th>@CommonText.Get("Status")</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><a class="d-flex align-items-center gap-2" asp-action="Details" asp-route-id="@item.Id"><img class="category-icon" src="@item.IconPath" alt="@CommonText.IconLabel(item.IconAlt)" />@item.Name</a></td><td>@CommonText.EnumLabel(item.Direction)</td><td>@CommonText.EnumLabel(item.Type)</td><td>@(item.AccountName ?? "—")</td><td>@(item.NextPayment?.ToString("yyyy-MM-dd") ?? "—")</td><td class="text-end">@MoneyFormatter.Format(item.OriginalAmount, item.Currency)</td><td class="text-end">@MoneyFormatter.Format(item.RemainingAmount, item.Currency)</td><td>@CommonText.EnumLabel(item.Status)</td></tr> }
</tbody></table></div> }
