@using PocketLedger.Localization
@model PocketLedger.Models.ViewModels.Transactions.TransactionDeleteViewModel
@{ ViewData["Title"] = CommonText.Get("Delete transaction"); }
<h1>@CommonText.Get("Delete transaction")</h1>
<div class="alert alert-warning">@CommonText.Format("Delete this {0} transaction?", CommonText.EnumLabel(Model.Type))</div>
<p class="d-flex align-items-center gap-2">
    @if (!string.IsNullOrWhiteSpace(Model.CategoryIconPath))
    {
        <img class="category-icon" src="@Model.CategoryIconPath" alt="@CommonText.IconLabel(Model.CategoryIconAlt)" />
    }
    <span>@Model.TransactionDate.ToString("yyyy-MM-dd") @Model.TransactionTime.ToString("HH:mm") · @MoneyFormatter.Format(Model.Amount, Model.Currency) · @Model.AccountName</span>
</p>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button class="btn btn-danger" type="submit">@CommonText.Get("Delete")</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">@CommonText.Get("Cancel")</a>
</form>
