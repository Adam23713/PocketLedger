@using PocketLedger.Localization
@model PocketLedger.Models.ViewModels.Transactions.TransactionFormViewModel
@{ ViewData["Title"] = CommonText.Get("Edit transaction"); }
<h1>@CommonText.Get("Edit transaction")</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-narrow">
    <input asp-for="Id" type="hidden" />
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary" type="submit">@CommonText.Get("Save")</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">@CommonText.Get("Cancel")</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><partial name="_FormScripts" /> }
