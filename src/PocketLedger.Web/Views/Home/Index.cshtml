@model PocketLedger.Models.ViewModels.Home.HomeViewModel
@using PocketLedger.Models.Enums
@{
    ViewData["Title"] = "Dashboard";
}
<script>
    if (localStorage.getItem("pocketledger-dashboard-amounts-hidden") === "true") document.documentElement.dataset.dashboardAmountsHidden = "true";
</script>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="mb-1">Dashboard</h1>
            <button class="dashboard-privacy-button" id="dashboard-privacy-button" type="button" aria-label="Hide dashboard amounts" aria-pressed="false" title="Hide dashboard amounts">
                <svg class="privacy-visible-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.75" /></svg>
                <svg class="privacy-hidden-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M3 3l18 18M10.6 6.1A10 10 0 0 1 12 6c6 0 9.5 6 9.5 6a16 16 0 0 1-2.1 2.8M6.2 6.2C3.8 8 2.5 12 2.5 12s3.5 6 9.5 6a9.8 9.8 0 0 0 3.1-.5M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
            </button>
        </div>
    </div>
    <a class="btn btn-outline-primary" asp-controller="Accounts" asp-action="Create">New account</a>
</div>
@foreach (var warning in Model.DebtFundingWarnings)
{
    <div class="alert alert-warning d-flex align-items-center gap-2" role="alert"><img class="category-icon" src="@warning.IconPath" alt="@warning.IconAlt" /><span><strong>Insufficient funds for <a asp-controller="Debts" asp-action="Details" asp-route-id="@warning.DebtId">@warning.DebtName</a>.</strong> @warning.Date.ToString("yyyy-MM-dd"): <span data-private-amount>@MoneyFormatter.Format(warning.Amount, warning.Currency)</span> from @warning.AccountName; current balance <span data-private-amount>@MoneyFormatter.Format(warning.AccountBalance, warning.Currency)</span>, shortfall <span data-private-amount>@MoneyFormatter.Format(warning.Shortfall, warning.Currency)</span>.</span></div>
}

<div class="row g-3 mb-4 dashboard-summary">
    <div class="col-6 col-lg-3"><div class="card dashboard-metric dashboard-metric-balance h-100"><div class="card-body"><div class="dashboard-metric-heading"><span class="dashboard-metric-icon"><partial name="_NavigationIcon" model='"Available"' /></span><span>Total balance</span></div>@foreach (var total in Model.MainBalances) { <div class="dashboard-metric-value" data-private-amount>@MoneyFormatter.Format(total.Amount, total.Currency)</div> }</div></div></div>
    <div class="col-6 col-lg-3"><div class="card dashboard-metric dashboard-metric-net-worth h-100"><div class="card-body"><div class="dashboard-metric-heading"><span class="dashboard-metric-icon"><partial name="_NavigationIcon" model='"Statistics"' /></span><span>Net worth</span></div>@foreach (var total in Model.NetWorthBalances) { <div class="dashboard-metric-value" data-private-amount>@MoneyFormatter.Format(total.Amount, total.Currency)</div> }</div></div></div>
    <div class="col-6 col-lg-2"><div class="card dashboard-metric dashboard-metric-accounts h-100"><div class="card-body"><div class="dashboard-metric-heading"><span class="dashboard-metric-icon"><partial name="_NavigationIcon" model='"Accounts"' /></span><span>Accounts</span></div><div class="dashboard-metric-value">@Model.AccountCount</div><small class="dashboard-metric-caption">Active financial accounts</small></div></div></div>
    <div class="col-12 col-lg-4"><div class="card dashboard-metric dashboard-metric-month h-100"><div class="card-body"><div class="dashboard-metric-heading"><span class="dashboard-metric-icon"><partial name="_NavigationIcon" model='"Calendar"' /></span><span>This month</span></div>@foreach (var total in Model.MonthlyTotals) { <div class="dashboard-period"><span><small>Income</small><strong class="text-success" data-private-amount>+@MoneyFormatter.Format(total.Income, total.Currency)</strong></span><span><small>Expenses</small><strong class="text-danger" data-private-amount>−@MoneyFormatter.Format(total.Expenses, total.Currency)</strong></span><span><small>Change</small><strong data-private-amount>@MoneyFormatter.Format(total.Change, total.Currency)</strong></span></div> }</div></div></div>
</div>

<h2 class="h4">Account balances</h2>
<div class="row g-3 mb-5">
    @if (Model.Accounts.Count == 0)
    {
        <div class="col"><div class="alert alert-info">No accounts yet. Create your first account to get started.</div></div>
    }
    @foreach (var account in Model.Accounts)
    {
        var accountType = account.Type switch { AccountType.BankAccount => "Bank Account", AccountType.CreditCard => "Credit Card", _ => account.Type.ToString() };
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card account-card h-100" style="background-color: @account.Color">
                <a class="card-body account-card-main text-decoration-none text-body" asp-controller="Accounts" asp-action="Details" asp-route-id="@account.Id">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <img class="account-icon" src="@account.IconPath" alt="@account.IconAlt" />
                            <h2 class="h5 mb-0">@account.Name</h2>
                        </div>
                        <span class="badge text-bg-light">@accountType</span>
                    </div>
                    <div class="display-6 fs-3"><span data-private-amount>@MoneyFormatter.Format(account.CurrentBalance, account.Currency)</span></div>
                </a>
                <div class="card-footer account-card-actions d-flex flex-nowrap gap-2">
                    <a class="btn btn-sm btn-danger dashboard-action-button" asp-controller="Transactions" asp-action="Create" asp-route-accountId="@account.Id" asp-route-type="Expense"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M8 12h8" /></svg>Expense</a>
                    <a class="btn btn-sm btn-success dashboard-action-button" asp-controller="Transactions" asp-action="Create" asp-route-accountId="@account.Id" asp-route-type="Income"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M8 12h8M12 8v8" /></svg>Income</a>
                    <a class="btn btn-sm btn-primary dashboard-action-button" asp-controller="Transactions" asp-action="Create" asp-route-accountId="@account.Id" asp-route-type="Transfer" title="Transfer out of @account.Name"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M19 12H5m5-5-5 5 5 5" /></svg>Transfer out</a>
                    <a class="btn btn-sm btn-primary dashboard-action-button" asp-controller="Transactions" asp-action="Create" asp-route-targetAccountId="@account.Id" asp-route-type="Transfer" title="Transfer into @account.Name"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>Transfer in</a>
                </div>
            </div>
        </div>
    }
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h4 mb-0">Latest transactions</h2>
    <a asp-controller="Transactions" asp-action="Index">View all</a>
</div>
@if (Model.RecentTransactions.Count == 0)
{
    <p class="text-muted">No transactions yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Date</th><th>Type</th><th>Account</th><th>Category</th><th class="text-end">Amount</th></tr></thead>
            <tbody>
            @foreach (var transaction in Model.RecentTransactions)
            {
                var negative = transaction.Type == TransactionType.Expense || transaction.Type == TransactionType.Adjustment && transaction.AdjustmentDirection == AdjustmentDirection.Decrease || transaction.Type == TransactionType.Transfer || transaction.DebtOperationType is DebtOperationType.Payment or DebtOperationType.EarlyRepayment or DebtOperationType.ManualCorrectionDecrease or DebtOperationType.ReceivedRepayment;
                <tr>
                    <td><a asp-controller="Transactions" asp-action="Details" asp-route-id="@transaction.Id">@transaction.TransactionDate.ToString("yyyy-MM-dd")</a></td>
                    <td>@transaction.Type</td>
                    <td>@(transaction.AccountName ?? "No account movement")</td>
                    <td>@if (!string.IsNullOrWhiteSpace(transaction.DebtIconPath)) { <img class="category-icon me-2" src="@transaction.DebtIconPath" alt="@transaction.DebtIconAlt" /> } else if (!string.IsNullOrWhiteSpace(transaction.CategoryIconPath)) { <img class="category-icon me-2" src="@transaction.CategoryIconPath" alt="@transaction.CategoryIconAlt" /> }@(transaction.DebtOperationType?.ToString() ?? transaction.CategoryName ?? "—")</td>
                    <td class="text-end @(negative ? "text-danger" : "text-success")">@(negative ? "−" : "+")@MoneyFormatter.Format(transaction.Amount, transaction.Currency)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
