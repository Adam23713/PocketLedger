@using PocketLedger.Localization
@model PocketLedger.Models.ViewModels.Categories.CategoryDeleteViewModel
@{ ViewData["Title"] = CommonText.Get("Delete category"); }
<h1>@CommonText.Get("Delete category")</h1>
<div class="alert alert-warning">@CommonText.Get("Delete") <strong>@Model.Name</strong>? Categories referenced by transactions or containing subcategories cannot be deleted.</div>
<dl class="row"><dt class="col-sm-3">@CommonText.Get("Type")</dt><dd class="col-sm-9">@CommonText.EnumLabel(Model.Type)</dd><dt class="col-sm-3">@CommonText.Get("Parent")</dt><dd class="col-sm-9">@(Model.ParentName ?? CommonText.Get("None"))</dd></dl>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button class="btn btn-danger" type="submit">@CommonText.Get("Delete")</button>
    <a class="btn btn-link" asp-action="Index">@CommonText.Get("Cancel")</a>
</form>
