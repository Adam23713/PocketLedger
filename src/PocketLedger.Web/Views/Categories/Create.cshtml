@using PocketLedger.Localization
@model PocketLedger.Models.ViewModels.Categories.CategoryFormViewModel
@{ ViewData["Title"] = CommonText.Get("New category"); }
<h1>@CommonText.Get("New category")</h1>
<form asp-action="Create" method="post" class="form-narrow">
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary" type="submit">@CommonText.Get("Create")</button>
    <a class="btn btn-link" asp-action="Index">@CommonText.Get("Cancel")</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
