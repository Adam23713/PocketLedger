@using PocketLedger.Localization
@model IReadOnlyList<PocketLedger.Models.ViewModels.Accounts.AccountListItemViewModel>
@{
    ViewData["Title"] = CommonText.Get("Accounts");
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@CommonText.Get("Accounts")</h1>
    <a class="btn btn-primary" asp-action="Create">@CommonText.Get("New account")</a>
</div>
@if (Model.Count == 0)
{
    <div class="alert alert-info">@CommonText.Get("No accounts have been created.")</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>@CommonText.Get("Name")</th><th>@CommonText.Get("Type")</th><th class="text-end">@CommonText.Get("Balance")</th><th>@CommonText.Get("Order")</th><th>@CommonText.Get("Included in")</th><th></th></tr></thead>
            <tbody>
            @foreach (var account in Model)
            {
                <tr>
                    <td><a class="d-inline-flex align-items-center gap-2" asp-action="Details" asp-route-id="@account.Id"><img class="account-icon account-icon-sm" src="@account.IconPath" alt="@CommonText.IconLabel(account.IconAlt)" />@account.Name</a></td>
                    <td>@CommonText.EnumLabel(account.Type)</td>
                    <td class="text-end">@MoneyFormatter.Format(account.CurrentBalance, account.Currency)</td>
                    <td>@account.DisplayOrder</td>
                    <td>
                        @if (account.IncludeInMainBalance) { <span class="badge text-bg-primary">@CommonText.Get("Main balance")</span> }
                        @if (account.IncludeInNetWorth) { <span class="badge text-bg-secondary">@CommonText.Get("Net worth")</span> }
                        @if (account.IncludeInStatistics) { <span class="badge text-bg-light">@CommonText.Get("Statistics")</span> }
                    </td>
                    <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@account.Id">@CommonText.Get("Edit")</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@account.Id">@CommonText.Get("Delete")</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
