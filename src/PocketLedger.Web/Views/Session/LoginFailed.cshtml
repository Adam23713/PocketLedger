@using PocketLedger.Localization
@{
    ViewData["Title"] = CommonText.Get("Sign in again");
}
<h1>@CommonText.Get("Sign in again")</h1>
<p>@CommonText.Get("We couldn't complete your sign-in. Your login request may have expired or already been used. Please start again from this browser and allow cookies.")</p>
<a class="btn btn-primary" asp-action="Login">@CommonText.Get("Sign in")</a>
