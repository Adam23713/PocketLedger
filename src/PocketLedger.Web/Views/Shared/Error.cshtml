@using PocketLedger.Localization
@model ErrorViewModel
@{
    ViewData["Title"] = CommonText.Get("Error");
}

<h1 class="text-danger">@CommonText.Get("Error.")</h1>
<h2 class="text-danger">@CommonText.Get("An error occurred while processing your request.")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@CommonText.Get("Request ID:")</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@CommonText.Get("Development Mode")</h3>
<p>@CommonText.Format("Switching to the {0} environment displays more details about the error.", "Development")</p>
<p>
    <strong>@CommonText.Get("The Development environment shouldn't be enabled for deployed applications.")</strong>
    @CommonText.Get("It can result in displaying sensitive information from exceptions to end users.")
    @CommonText.Format("For local debugging, set {0} to {1} and restart the app.", "ASPNETCORE_ENVIRONMENT", "Development")
</p>
