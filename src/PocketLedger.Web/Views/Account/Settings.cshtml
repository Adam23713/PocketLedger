@model PocketLedger.Models.ViewModels.Account.SettingsViewModel
@using PocketLedger.Models.Enums
@{ ViewData["Title"] = "Settings"; }
<h1>Settings</h1>
<form method="post" class="settings-form">
    <div asp-validation-summary="All" class="text-danger"></div>
    <section class="card card-body mb-4">
        <h2 class="h5">Profile</h2>
        <div class="mb-3"><label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" class="form-control" /><span asp-validation-for="DisplayName" class="text-danger"></span></div>
        <label class="form-label">Avatar</label>
        <div class="avatar-selector mb-3">
        @for (var avatar = 1; avatar <= 5; avatar++)
        {
            <label><input asp-for="AvatarId" type="radio" value="@avatar" /><img src="~/images/avatars/@($"avatar-{avatar}.png")" alt="Avatar @avatar" /></label>
        }
        </div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="DefaultCurrency" class="form-label">Default currency</label><select asp-for="DefaultCurrency" class="form-select" data-default-currency>@foreach (var currency in Currencies.All.OrderBy(item => item.Code)) { <option value="@currency.Code">@currency.Code — @currency.DisplayName</option> }</select><div class="form-text">Used for new accounts and as the preselected currency in forms.</div></div>
            <div class="col-md-6"><label asp-for="TimeZoneId" class="form-label">Time zone</label><select asp-for="TimeZoneId" class="form-select">@if (!UserTimeZones.All.Any(zone => zone.Id == Model.TimeZoneId)) { <option value="@Model.TimeZoneId">@Model.TimeZoneId</option> }@foreach (var zone in UserTimeZones.All) { <option value="@zone.Id">@zone.DisplayName</option> }</select></div>
        </div>
    </section>
    <section class="card card-body mb-4">
        <h2 class="h5">Currencies</h2>
        <p class="text-muted">Select a currency to adjust how its amounts are displayed. Currencies that are not in the list use the standard format.</p>
        <div class="currency-settings">
            <div class="currency-settings-list">
                <div class="list-group" data-currency-list>
                @for (var index = 0; index < Model.CurrencyFormats.Count; index++)
                {
                    var definition = Currencies.Get(Model.CurrencyFormats[index].CurrencyCode);
                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2" data-currency-item="@definition.Code">
                        <span><strong>@definition.Code</strong> <small class="text-muted">@definition.DisplayName</small></span>
                        <span class="badge text-bg-primary" data-default-badge hidden="@(definition.Code != Model.DefaultCurrency)">Default</span>
                    </button>
                }
                </div>
                <div class="input-group mt-3">
                    <select class="form-select" aria-label="Currency to add" data-currency-add>
                        <option value="">Add a currency…</option>
                        @foreach (var currency in Currencies.All.OrderBy(item => item.Code))
                        {
                            <option value="@currency.Code" data-name="@currency.DisplayName" data-symbol="@currency.Symbol" data-decimals="@currency.DecimalDigits" hidden="@Model.CurrencyFormats.Any(item => item.CurrencyCode == currency.Code)">@currency.Code — @currency.DisplayName</option>
                        }
                    </select>
                    <button type="button" class="btn btn-outline-primary" data-currency-add-button>Add</button>
                </div>
            </div>
            <div class="currency-settings-editor border rounded p-3" data-currency-editors>
                <p class="text-muted mb-0" data-currency-empty hidden>No currency selected.</p>
                @for (var index = 0; index < Model.CurrencyFormats.Count; index++)
                {
                    <partial name="~/Views/Account/_CurrencyFormatEditor.cshtml" model="new PocketLedger.Models.ViewModels.Account.CurrencyFormatEditorViewModel(index.ToString(System.Globalization.CultureInfo.InvariantCulture), Model.CurrencyFormats[index])" />
                }
            </div>
        </div>
        <template id="currency-format-template"><partial name="~/Views/Account/_CurrencyFormatEditor.cshtml" model='new PocketLedger.Models.ViewModels.Account.CurrencyFormatEditorViewModel("__key__", new PocketLedger.Models.ViewModels.Account.CurrencyFormatViewModel())' /></template>
    </section>
    <button class="btn btn-primary" type="submit">Save settings</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/settings.js" asp-append-version="true"></script> }
