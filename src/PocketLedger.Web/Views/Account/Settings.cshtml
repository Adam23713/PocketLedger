@model PocketLedger.Models.ViewModels.Account.SettingsViewModel
@using PocketLedger.Models.Enums
@{ ViewData["Title"] = "Settings"; }
<h1>Settings</h1>
<form method="post" class="settings-form">
    <div asp-validation-summary="All" class="text-danger"></div>
    <section class="card card-body mb-4">
        <h2 class="h5">Profile</h2>
        <div class="mb-3"><label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" class="form-control" /><span asp-validation-for="DisplayName" class="text-danger"></span></div>
        <label class="form-label">Avatar</label>
        <div class="avatar-selector mb-3">
        @for (var avatar = 1; avatar <= 10; avatar++)
        {
            <label><input asp-for="AvatarId" type="radio" value="@avatar" /><img src="~/images/avatars/@($"avatar-{avatar}.png")" alt="Avatar @avatar" /></label>
        }
        </div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="DefaultCurrency" class="form-label">Default currency</label><select asp-for="DefaultCurrency" class="form-select">@foreach (var currency in Currencies.All) { <option value="@currency.Code">@currency.Code — @currency.DisplayName</option> }</select></div>
            <div class="col-md-6"><label asp-for="TimeZoneId" class="form-label">Time zone (IANA)</label><input asp-for="TimeZoneId" class="form-control" list="time-zones" /><datalist id="time-zones"><option>Europe/Budapest</option><option>Europe/London</option><option>America/New_York</option><option>Asia/Tokyo</option></datalist></div>
        </div>
    </section>
    <section class="card card-body mb-4">
        <h2 class="h5">Currency formatting</h2>
        <p class="text-muted">Each currency has its own display rules.</p>
        <div class="row g-3">
        @for (var index = 0; index < Model.CurrencyFormats.Count; index++)
        {
            <div class="col-lg-4"><div class="border rounded p-3 currency-format-card" data-currency-format data-symbol="@Currencies.Get(Model.CurrencyFormats[index].CurrencyCode).Symbol">
                <h3 class="h6">@Model.CurrencyFormats[index].CurrencyCode</h3><input asp-for="CurrencyFormats[index].CurrencyCode" type="hidden" />
                <div class="mb-2"><label asp-for="CurrencyFormats[index].DecimalPlaces" class="form-label">Decimal places</label><select asp-for="CurrencyFormats[index].DecimalPlaces" class="form-select" data-format-field>@for (var n = 0; n <= 4; n++) { <option value="@n">@n</option> }</select></div>
                <div class="row g-2"><div class="col"><label class="form-label">Decimal separator</label><input asp-for="CurrencyFormats[index].DecimalSeparator" class="form-control" maxlength="1" data-format-field /></div><div class="col"><label class="form-label">Thousands separator</label><input asp-for="CurrencyFormats[index].ThousandsSeparator" class="form-control" maxlength="1" data-format-field /></div></div>
                <div class="row g-2 mt-1"><div class="col"><label class="form-label">Show</label><select asp-for="CurrencyFormats[index].CurrencyDisplay" asp-items="Html.GetEnumSelectList<CurrencyDisplay>()" class="form-select" data-format-field></select></div><div class="col"><label class="form-label">Position</label><select asp-for="CurrencyFormats[index].CurrencyPosition" asp-items="Html.GetEnumSelectList<CurrencyPosition>()" class="form-select" data-format-field></select></div></div>
                <div class="form-check mt-2"><input asp-for="CurrencyFormats[index].UseSpace" class="form-check-input" data-format-field /><label asp-for="CurrencyFormats[index].UseSpace" class="form-check-label">Space between value and currency</label></div>
                <div class="mt-3"><small class="text-muted">Preview</small><div class="h5 mb-0" data-format-preview></div></div>
            </div></div>
        }
        </div>
    </section>
    <button class="btn btn-primary" type="submit">Save settings</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/settings.js" asp-append-version="true"></script> }
