@model PocketLedger.Models.ViewModels.Statistics.StatisticsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Statistics";
    ViewData["Currency"] = Model.Currency;
    var selected = new DateOnly(Model.Year, Model.Month, 1);
    var previous = selected.AddMonths(-1);
    var next = selected.AddMonths(1);
    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
}
<div class="calendar-toolbar mb-3">
    <h1>Statistics</h1>
    <div class="calendar-month-picker" aria-label="Selected statistics month">
        <a class="calendar-month-arrow" asp-route-year="@previous.Year" asp-route-month="@previous.Month" asp-route-currency="@Model.Currency" aria-label="Previous month">←</a>
        <strong>@selected.ToString("MMMM yyyy")</strong>
        <a class="calendar-month-arrow" asp-route-year="@next.Year" asp-route-month="@next.Month" asp-route-currency="@Model.Currency" aria-label="Next month">→</a>
    </div>
</div>
<form method="get" class="calendar-currency-selector mb-3">
    <input type="hidden" name="year" value="@Model.Year" />
    <input type="hidden" name="month" value="@Model.Month" />
    <label class="form-label" for="statistics-currency">Currency</label>
    <select class="form-select form-select-sm" id="statistics-currency" name="currency" onchange="this.form.submit()" disabled="@(Model.AvailableCurrencies.Count == 0)">
        @if (Model.AvailableCurrencies.Count == 0) { <option>No transaction currencies this month</option> }
        else { @foreach (var currency in Model.AvailableCurrencies) { <option value="@currency.Code" selected="@(currency.Code == Model.Currency)">@currency.Code — @currency.DisplayName</option> } }
    </select>
</form>
<div class="row g-3 mb-4 dashboard-summary statistics-summary">
    <div class="col-6 col-lg-3"><div class="card dashboard-metric statistics-metric-income h-100"><div class="card-body"><div class="dashboard-metric-heading"><span class="dashboard-metric-icon"><partial name="_NavigationIcon" model='"Income"' /></span><span>Income</span></div><div class="dashboard-metric-value text-success">@MoneyFormatter.Format(Model.Income, Model.Currency)</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card dashboard-metric statistics-metric-expenses h-100"><div class="card-body"><div class="dashboard-metric-heading"><span class="dashboard-metric-icon"><partial name="_NavigationIcon" model='"Expense"' /></span><span>Expenses</span></div><div class="dashboard-metric-value text-danger">@MoneyFormatter.Format(Model.Expenses, Model.Currency)</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card dashboard-metric statistics-metric-savings h-100"><div class="card-body"><div class="dashboard-metric-heading"><span class="dashboard-metric-icon"><partial name="_NavigationIcon" model='"Available"' /></span><span>Savings</span></div><div class="dashboard-metric-value">@MoneyFormatter.Format(Model.Savings, Model.Currency)</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card dashboard-metric statistics-metric-balance h-100"><div class="card-body"><div class="dashboard-metric-heading"><span class="dashboard-metric-icon"><partial name="_NavigationIcon" model='"Statistics"' /></span><span>Balance</span></div><div class="dashboard-metric-value">@MoneyFormatter.Format(Model.Balance, Model.Currency)</div></div></div></div>
</div>
<section class="mb-5" aria-labelledby="expense-distribution-heading">
    <h2 class="h4" id="expense-distribution-heading">Expenses by main category</h2>
    @if (Model.ExpenseMainCategories.Count == 0)
    {
        <p class="text-muted">No expense data for this month.</p>
    }
    else
    {
        <div class="statistics-category-layout">
            <div>
                <div class="statistics-doughnut-container"><canvas id="expense-category-chart" aria-label="Expense distribution by main category"></canvas></div>
                <div class="statistics-category-selector" id="expense-category-selector" aria-label="Select a main category"></div>
            </div>
            <div class="statistics-breakdown" aria-live="polite">
                <h3 class="h5" id="expense-breakdown-heading"></h3>
                <p class="text-muted" id="expense-breakdown-total"></p>
                <div class="table-responsive edge-to-edge-table">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Subcategory</th><th class="text-end">Amount</th><th class="text-end">Share</th></tr></thead>
                        <tbody id="expense-breakdown-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</section>
<section class="mb-5" aria-labelledby="monthly-trend-heading">
    <h2 class="h4" id="monthly-trend-heading">Income and expenses over the last 12 months</h2>
    <div class="statistics-trend-container"><canvas id="monthly-trend-chart" aria-label="Income and expenses over the last 12 months"></canvas></div>
</section>
<div class="row g-4">
    <div class="col-lg-6"><h2 class="h4">Income by category</h2><partial name="_CategoryBreakdown" model="Model.IncomeByCategory" /></div>
    <div class="col-lg-6"><h2 class="h4">Expenses by category</h2><partial name="_CategoryBreakdown" model="Model.ExpenseByCategory" /></div>
</div>
<h2 class="h4 mt-4">Recurring expenses by main category</h2>
@if (Model.RecurringExpenses.Count == 0) { <p class="text-muted">No recurring expenses are scheduled for this month.</p> }
else
{
    <div class="table-responsive edge-to-edge-table">
        <table class="table">
            <thead><tr><th>Main category</th><th class="text-end">Occurrences</th><th class="text-end">Monthly expense</th></tr></thead>
            <tbody>@foreach (var item in Model.RecurringExpenses) { <tr><td><img class="category-icon me-2" src="@item.IconPath" alt="@item.IconAlt" />@item.MainCategoryName</td><td class="text-end">@item.OccurrenceCount</td><td class="text-end">@MoneyFormatter.Format(item.Amount, item.Currency)</td></tr> }</tbody>
            <tfoot><tr class="fw-semibold"><th>Total</th><td class="text-end">@Model.RecurringExpenses.Sum(item => item.OccurrenceCount)</td><td class="text-end">@MoneyFormatter.Format(Model.RecurringExpenses.Sum(item => item.Amount), Model.Currency)</td></tr></tfoot>
        </table>
    </div>
}
<h2 class="h4 mt-4">Account balances</h2>
<div class="table-responsive edge-to-edge-table"><table class="table"><thead><tr><th>Account</th><th class="text-end">Balance</th></tr></thead><tbody>@foreach (var account in Model.AccountBalances) { <tr><td><a asp-controller="Accounts" asp-action="Details" asp-route-id="@account.Id">@account.Name</a></td><td class="text-end">@MoneyFormatter.Format(account.Balance, account.Currency)</td></tr> }</tbody></table></div>
<h2 class="h4 mt-4">Last 12 months</h2>
<div class="table-responsive edge-to-edge-table"><table class="table table-sm"><thead><tr><th>Month</th><th class="text-end">Income</th><th class="text-end">Expenses</th><th class="text-end">Savings</th><th class="text-end">Balance</th></tr></thead><tbody>@foreach (var item in Model.MonthlyTrend) { <tr><td>@(new DateOnly(item.Year, item.Month, 1).ToString("yyyy MMM"))</td><td class="text-end">@MoneyFormatter.Format(item.Income, Model.Currency)</td><td class="text-end">@MoneyFormatter.Format(item.Expenses, Model.Currency)</td><td class="text-end">@MoneyFormatter.Format(item.Savings, Model.Currency)</td><td class="text-end">@MoneyFormatter.Format(item.Balance, Model.Currency)</td></tr> }</tbody></table></div>

@section Scripts {
    <script id="expense-main-category-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.ExpenseMainCategories, jsonOptions))</script>
    <script id="monthly-trend-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.MonthlyTrend, jsonOptions))</script>
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script src="~/js/statistics.js" asp-append-version="true"></script>
}
