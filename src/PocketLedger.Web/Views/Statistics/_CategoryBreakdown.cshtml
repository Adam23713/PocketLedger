@model IReadOnlyList<PocketLedger.Models.ViewModels.Statistics.StatisticsCategoryViewModel>
@if (Model.Count == 0) { <p class="text-muted">No data.</p> }
else { <div class="list-group">@foreach (var item in Model) { <div class="list-group-item d-flex justify-content-between align-items-center"><span class="d-flex align-items-center gap-2"><img class="category-icon" src="@item.IconPath" alt="@item.IconAlt" />@item.Name</span><strong>@MoneyFormatter.Format(item.Amount, (string?)ViewData["Currency"])</strong></div> }</div> }
