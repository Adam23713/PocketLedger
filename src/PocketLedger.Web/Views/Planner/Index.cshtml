@model PocketLedger.Services.Interfaces.PlannerMonth
@using System.Globalization
@using PocketLedger.Models.Enums
@using PocketLedger.Models.ViewModels.Planner
@using PocketLedger.Services
@using PocketLedger.Services.Interfaces
@{
    ViewData["Title"] = "Monthly planner";
    var plannedEvents = Model.Events;
    var previous = Model.Month.AddMonths(-1);
    var next = Model.Month.AddMonths(1);
}
<div class="planner-header">
    <div><h1>Monthly planner</h1><p class="mb-0">Plan your month and see what to expect.</p></div>
    <nav class="planner-month" aria-label="Select month">
        @if (previous.Year >= 2) { <a class="btn btn-sm btn-outline-secondary" asp-route-year="@previous.Year" asp-route-month="@previous.Month" aria-label="Previous month">‹</a> }
        <strong>@Model.Month.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("en-US"))</strong>
        @if (next <= new DateOnly(Model.Today.Year, Model.Today.Month, 1).AddYears(10)) { <a class="btn btn-sm btn-outline-secondary" asp-route-year="@next.Year" asp-route-month="@next.Month" aria-label="Next month">›</a> }
    </nav>
</div>
@if (Model.IsClosed) { <div class="planner-notice">@(Model.HasSnapshot ? "This month is closed. Its saved plan is read-only." : "No saved plan is available for this month.")</div> }
<div class="planner-summary">
    <partial name="_Metric" model='new PlannerMetricViewModel("Expected income", "Income", "positive", Model.Totals.Select(item => new PlannerMetricAmount(item.Currency, item.Income, item.PreviousIncome)).ToList())' />
    <partial name="_Metric" model='new PlannerMetricViewModel("Expected expenses", "Expense", "negative", Model.Totals.Select(item => new PlannerMetricAmount(item.Currency, item.Expenses, item.PreviousExpenses)).ToList())' />
    <partial name="_Metric" model='new PlannerMetricViewModel("Expected closing balance", "Accounts", "", Model.Totals.Select(item => new PlannerMetricAmount(item.Currency, item.ClosingBalance, item.PreviousClosingBalance)).ToList())' />
    <partial name="_Metric" model='new PlannerMetricViewModel("Available to spend", "Available", "positive", Model.Totals.Select(item => new PlannerMetricAmount(item.Currency, item.Available, item.PreviousAvailable)).ToList())' />
</div>
<div class="planner-columns">
    <div class="planner-stack">
        <partial name="_Table" model='new PlannerTableViewModel("Expected income", TransactionType.Income, Model.Month, plannedEvents.Where(item => item.Classification == TransactionReportingClassification.Income).ToList(), Model.IsClosed)' />
        <partial name="_Table" model='new PlannerTableViewModel("Expected expenses", TransactionType.Expense, Model.Month, plannedEvents.Where(item => item.Classification == TransactionReportingClassification.Expense && item.Source == PlannerEventSource.Planned).ToList(), Model.IsClosed)' />
        <partial name="_Table" model='new PlannerTableViewModel("Fixed expenses", TransactionType.Expense, Model.Month, plannedEvents.Where(item => item.Classification == TransactionReportingClassification.Expense && item.Source == PlannerEventSource.Recurring).ToList(), true)' />
        <partial name="_Table" model='new PlannerTableViewModel("Transfers", TransactionType.Transfer, Model.Month, plannedEvents.Where(item => item.Type == TransactionType.Transfer).ToList(), Model.IsClosed)' />
        @if (plannedEvents.Any(item => item.Type == TransactionType.Adjustment))
        {
            <section class="planner-panel"><h2>Balance adjustments</h2><p class="planner-muted">These adjustments affect balances without counting as income or expenses.</p>
                @foreach (var item in plannedEvents.Where(item => item.Type == TransactionType.Adjustment)) { <p>@item.Date?.ToString("MM. dd.") · @item.AccountName · @MoneyFormatter.Format(item.SourceChange, item.AccountCurrency)</p> }
            </section>
        }
    </div>
    <div class="planner-stack">
        <section class="planner-panel">
            <div class="planner-panel-header"><h2>Expected balance over time</h2></div>
            @foreach (var currency in Model.Points.Select(point => point.Currency).Distinct())
            {
                <partial name="_Chart" model="Model.Points.Where(point => point.Currency == currency).ToList()" />
            }
            @if (Model.Points.Count == 0) { <p class="planner-muted">Include an account in the main balance to see the chart.</p> }
            <small class="planner-muted">Accounts included in the main balance, grouped by currency. Undated items are excluded from the daily chart.</small>
        </section>
        <section class="planner-panel">
            <div class="planner-panel-header"><h2>Expected account balances</h2><a asp-controller="Accounts" asp-action="Index">Details</a></div>
            @foreach (var account in Model.Accounts)
            {
                @if (!Model.IsClosed)
                {
                    <form class="planner-opening" asp-action="OpeningBalance" asp-route-year="@Model.Month.Year" asp-route-month="@Model.Month.Month" asp-route-accountId="@account.Id" method="post">
                        <label for="opening-@account.Id" class="form-label">@account.Name · Expected opening balance (@account.Currency)</label>
                        <div class="d-flex gap-2 align-items-center">
                            <input id="opening-@account.Id" class="form-control" name="Amount" type="number" step="0.0001" value="@((account.UseCurrentBalance ? account.OpeningBalance : account.CustomOpeningBalance ?? account.OpeningBalance).ToString(CultureInfo.InvariantCulture))" data-current="@account.CurrentBalance.ToString(CultureInfo.InvariantCulture)" data-custom="@((account.CustomOpeningBalance ?? account.OpeningBalance).ToString(CultureInfo.InvariantCulture))" disabled="@account.UseCurrentBalance" />
                            <button class="btn btn-sm btn-outline-primary" type="submit">Save</button>
                        </div>
                        <div class="form-check form-switch mt-2"><input class="form-check-input" type="checkbox" role="switch" name="UseCurrentBalance" value="true" id="follow-@account.Id" checked="@account.UseCurrentBalance" /><label class="form-check-label" for="follow-@account.Id">Use current balance</label></div>
                    </form>
                }
                <div class="planner-account"><div><strong>@account.Name</strong><small>Current balance: @MoneyFormatter.Format(account.CurrentBalance, account.Currency)</small><small>Opening balance: @MoneyFormatter.Format(account.OpeningBalance, account.Currency)</small>@if (!account.IncludeInMainBalance) { <small>Excluded from main balance</small> }</div>
                <div><strong>@MoneyFormatter.Format(account.ClosingBalance, account.Currency)</strong><div class="@(account.Change < 0 ? "planner-negative" : "planner-positive")">@(account.Change > 0 ? "+" : "")@MoneyFormatter.Format(account.Change, account.Currency)</div><small>@(account.ChangePercent is { } percentage ? $"{percentage:+0.#;-0.#;0}%" : "%: —")</small></div></div>
            }
            @if (Model.Accounts.Count == 0) { <p class="planner-muted">Create an account to start planning.</p> }
            @foreach (var total in Model.Totals)
            {
                @if (total.Expenses > total.Income) { <div class="planner-notice negative"><strong>Negative monthly cash flow · @total.Currency</strong><p class="mb-0">Expenses exceed income this month.</p></div> }
                else if (total.Available > 0) { <div class="planner-notice positive"><strong>You are on track!</strong><p class="mb-0">After monthly budgets, @MoneyFormatter.Format(total.Available, total.Currency) remains available to spend.</p></div> }
            }
            @foreach (var account in Model.Accounts.Where(account => account.ClosingBalance <= 0)) { <div class="planner-notice negative"><strong>Attention: @account.Name</strong><p class="mb-0">The expected closing balance is zero or negative.</p></div> }
            <div class="planner-notice"><p class="mb-0">This planner uses planned items and active recurring income and expenses, including loan payments. Figures are estimates.</p></div>
            <div class="planner-notice"><p class="mb-0">Available to spend = expected closing balance of accounts included in the main balance − undated expense budgets. Undated income contributes to the closing balance. Currency conversions use the amount specified for the account.</p></div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/planner-opening.js" asp-append-version="true"></script>
}
