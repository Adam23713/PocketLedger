@using PocketLedger.Localization
@model PocketLedger.Services.Interfaces.PlannerItemInput
@{ ViewData["Title"] = CommonText.Get("Delete planned item"); }
<div class="planner-panel planner-form">
    <h1 class="h3">@CommonText.Get("Delete planned item")</h1>
    <p>@(Model.Note ?? CommonText.EnumLabel(Model.Type)) · @MoneyFormatter.Format(Model.Amount, Model.Currency) · @(Model.PlannedDate?.ToString("yyyy. MM. dd.") ?? Model.Month.ToString("yyyy. MM."))</p>
    <p>@CommonText.Get("Delete this item from the monthly plan?")</p>
    <form asp-action="Delete" asp-route-id="@ViewData["Id"]" method="post">
        <button type="submit" class="btn btn-danger">@CommonText.Get("Delete planned item")</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-year="@Model.Month.Year" asp-route-month="@Model.Month.Month">@CommonText.Get("Cancel")</a>
    </form>
</div>
