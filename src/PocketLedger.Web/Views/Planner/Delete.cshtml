@model PocketLedger.Services.Interfaces.PlannerItemInput
@{ ViewData["Title"] = "Delete planned item"; }
<div class="planner-panel planner-form">
    <h1 class="h3">Delete planned item</h1>
    <p>@(Model.Note ?? Model.Type.ToString()) · @MoneyFormatter.Format(Model.Amount, Model.Currency) · @(Model.PlannedDate?.ToString("yyyy. MM. dd.") ?? Model.Month.ToString("yyyy. MM."))</p>
    <p>Delete this item from the monthly plan?</p>
    <form asp-action="Delete" asp-route-id="@ViewData["Id"]" method="post">
        <button type="submit" class="btn btn-danger">Delete planned item</button>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-year="@Model.Month.Year" asp-route-month="@Model.Month.Month">Cancel</a>
    </form>
</div>
