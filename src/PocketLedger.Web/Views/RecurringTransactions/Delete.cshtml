@using PocketLedger.Localization
@model PocketLedger.Models.Entities.RecurringTransaction
@{ ViewData["Title"] = CommonText.Get("Delete recurring transaction"); }
<h1>@CommonText.Get("Delete recurring transaction")</h1><div class="alert alert-warning">@CommonText.Format("Delete this {0} {1} template?", CommonText.EnumLabel(Model.Frequency), CommonText.EnumLabel(Model.Type))</div><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button class="btn btn-danger">@CommonText.Get("Delete")</button><a class="btn btn-link" asp-action="Index">@CommonText.Get("Cancel")</a></form>
