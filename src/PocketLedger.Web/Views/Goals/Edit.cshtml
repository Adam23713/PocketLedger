@model PocketLedger.Models.ViewModels.Goals.GoalFormViewModel
@{ ViewData["Title"] = "Edit goal"; }
<h1>Edit goal</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-narrow mx-auto card card-body goal-form-surface">
    <input asp-for="Id" type="hidden" />
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
