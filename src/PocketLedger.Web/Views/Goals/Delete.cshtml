@using PocketLedger.Localization
@model PocketLedger.Models.ViewModels.Goals.GoalViewModel
@{ ViewData["Title"] = CommonText.Get("Delete goal"); }
<h1>@CommonText.Get("Delete goal")</h1>
<div class="alert alert-danger"><strong>@CommonText.Get("This action cannot be undone.")</strong> Deleting <strong>@Model.Name</strong> removes the goal and its saved amount (@MoneyFormatter.Format(Model.SavedAmount, Model.Currency)). Your accounts and transactions are not affected.</div>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button class="btn btn-danger" type="submit">@CommonText.Get("Delete goal")</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">@CommonText.Get("Cancel")</a>
</form>
