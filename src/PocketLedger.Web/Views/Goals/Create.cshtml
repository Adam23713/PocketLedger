@model PocketLedger.Models.ViewModels.Goals.GoalFormViewModel
@{ ViewData["Title"] = "New goal"; }
<h1>New goal</h1>
<form asp-action="Create" method="post" class="form-narrow mx-auto card card-body goal-form-surface">
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary" type="submit">Create</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
