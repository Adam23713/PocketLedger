@using PocketLedger.Localization
@model PocketLedger.Models.ViewModels.Goals.GoalFormViewModel
@{ ViewData["Title"] = CommonText.Get("New goal"); }
<h1>@CommonText.Get("New goal")</h1>
<form asp-action="Create" method="post" class="form-narrow mx-auto card card-body goal-form-surface">
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary" type="submit">@CommonText.Get("Create")</button>
    <a class="btn btn-link" asp-action="Index">@CommonText.Get("Cancel")</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
