@model PocketLedger.Models.ViewModels.ImportExport.ExcelExportViewModel
@{ ViewData["Title"] = "Export encrypted Excel"; }
<h1>Export encrypted Excel</h1>
<p>The exported workbook contains the transactions matching the selected filters and requires its password when opened.</p>
<form method="post" class="card card-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="Filter.DateFrom" type="hidden" />
    <input asp-for="Filter.DateTo" type="hidden" />
    <input asp-for="Filter.Year" type="hidden" />
    <input asp-for="Filter.Month" type="hidden" />
    <input asp-for="Filter.AccountId" type="hidden" />
    <input asp-for="Filter.CategoryId" type="hidden" />
    <input asp-for="Filter.Type" type="hidden" />
    <input asp-for="Filter.AmountFrom" type="hidden" />
    <input asp-for="Filter.AmountTo" type="hidden" />
    <input asp-for="Filter.Search" type="hidden" />
    <div class="mb-3"><label asp-for="Password" class="form-label">Excel password</label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span><div class="form-text">Use between 10 and 128 characters. A forgotten password cannot be recovered.</div></div>
    <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Confirm Excel password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
    <div><button class="btn btn-primary">Download encrypted Excel</button> <a class="btn btn-outline-secondary" asp-controller="Transactions" asp-action="Index">Cancel</a></div>
</form>
