@using PocketLedger.Localization
@model PocketLedger.Models.ViewModels.ImportExport.CsvImportViewModel
@{ ViewData["Title"] = CommonText.Get("Import CSV"); }
<h1>@CommonText.Get("Import CSV")</h1>
<form asp-action="PreviewImport" method="post" enctype="multipart/form-data" class="mb-4"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><input class="form-control" type="file" name="file" accept=".csv,text/csv" /></div><button class="btn btn-primary">@CommonText.Get("Preview")</button></form>
@if (Model.Preview is not null)
{
    <div class="alert alert-info">Ready: @Model.Preview.ValidCount · Duplicates: @Model.Preview.DuplicateCount · Invalid: @Model.Preview.InvalidCount</div>
    <div class="table-responsive"><table class="table table-sm"><thead><tr><th>@CommonText.Get("Row")</th><th>@CommonText.Get("Status")</th><th>@CommonText.Get("Date")</th><th>@CommonText.Get("Account")</th><th>@CommonText.Get("Type")</th><th>@CommonText.Get("Category")</th><th>@CommonText.Get("Amount")</th><th>@CommonText.Get("Message")</th></tr></thead><tbody>@foreach (var row in Model.Preview.Rows) { <tr class="@(!row.IsValid ? "table-danger" : row.IsDuplicate ? "table-warning" : "")"><td>@row.RowNumber</td><td>@CommonText.Get(!row.IsValid ? "Invalid" : row.IsDuplicate ? "Duplicate" : "Ready")</td><td>@row.Date</td><td>@row.Account</td><td>@CommonText.EnumLabel(row.Type)</td><td>@row.Category</td><td>@row.Amount</td><td>@CommonText.Get(row.Error ?? string.Empty)</td></tr> }</tbody></table></div>
    @if (Model.Preview.ValidCount > 0) { <form asp-action="ConfirmImport" method="post"><textarea asp-for="Csv" hidden></textarea><button class="btn btn-success">@CommonText.Get("Import valid rows")</button></form> }
}
