#  PocketLedger local development configuration
#
#  Checked in on purpose: every value here is a throwaway development secret.
#  NEVER reuse any of them in production; start from .env.example instead.
#  Section numbers match .env.example.


################################ 2. LOCAL DOMAINS ################################
#  The services run on localhost, one port each, without Cloudflare or Caddy:
#  landing 5053, docs 5054, web 5050, API 5051, Identity 5052. The theme cookie is
#  shared on plain "localhost".
##################################################################################
POCKETLEDGER_LANDING_DOMAIN=localhost:5053
POCKETLEDGER_DOCS_DOMAIN=localhost:5054
POCKETLEDGER_WEB_DOMAIN=localhost:5050
POCKETLEDGER_API_DOMAIN=localhost:5051
POCKETLEDGER_IDENTITY_DOMAIN=localhost:5052
POCKETLEDGER_THEME_COOKIE_DOMAIN=localhost


######################### 3. SERVICE-TO-SERVICE SECRETS ##########################
#  Same roles as in production (Web -> Identity client secret, Identity admin
#  calls, token signing). The signing key is shared by every developer so
#  locally issued tokens stay interoperable.
##################################################################################
POCKETLEDGER_WEB_CLIENT_SECRET=development-only-change-me
POCKETLEDGER_ADMIN_OPERATIONS_KEY=development-only-admin-operations-key
POCKETLEDGER_SIGNING_KEY=cG9ja2V0bGVkZ2VyLWRldmVsb3BtZW50LXNpZ25pbmcta2V5LWNoYW5nZS1tZS0xMjM0NTY3ODkw


################################## 4. DATABASES ##################################
#  Matches the local PostgreSQL databases created by compose.development.yaml.
##################################################################################
POSTGRES_USER=pocketledger
POSTGRES_PASSWORD=pocketledger


##################### 5. FIRST ADMINISTRATOR & REGISTRATION ######################
#  Account created by `bootstrap-identity`. Registration is open locally so
#  sign-up flows can be tested.
##################################################################################
POCKETLEDGER_INITIAL_USERNAME=admin
POCKETLEDGER_INITIAL_PASSWORD=this-is-a-strong-password[1234]
POCKETLEDGER_PUBLIC_REGISTRATION_ENABLED=true
POCKETLEDGER_PUBLIC_REGISTRATION_MAXIMUM_USERS=5


########################## 6. EDGE SECURITY (CROWDSEC) ###########################
#  Only needed so Compose interpolation succeeds; do not deploy these keys.
#  The Identity key stays separate from the Caddy key, as in production.
##################################################################################
CROWDSEC_API_KEY=development-only-not-for-production
CROWDSEC_IDENTITY_API_KEY=87128fc43b40da601f159b652641435ab1f078cb09fd35fc9f56c19befb0bb3a


####################### 7. ENCRYPTION KEYS & INTERNAL TLS ########################
#  Prepare the host keys, certificates and internal TLS material first with
#  the tools/initialize-*.sh scripts; see README.md.
##################################################################################
POCKETLEDGER_SECURITY_DIRECTORY=/opt/pocketledger-security


########################## 9. SOCIAL SIGN-IN (OPTIONAL) ##########################
#  Leave empty unless you test Google or Facebook login with your own
#  development app credentials. Never commit real values.
##################################################################################
POCKETLEDGER_GOOGLE_CLIENT_ID=
POCKETLEDGER_GOOGLE_CLIENT_SECRET=
POCKETLEDGER_FACEBOOK_APP_ID=
POCKETLEDGER_FACEBOOK_APP_SECRET=
