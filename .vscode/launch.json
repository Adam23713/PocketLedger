{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PocketLedger (HTTP 5050)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build PocketLedger",
            "program": "${workspaceFolder}/src/PocketLedger/bin/Debug/net10.0/PocketLedger.dll",
            "cwd": "${workspaceFolder}/src/PocketLedger",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://0.0.0.0:5050"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+http://\\S+:([0-9]+)",
                "uriFormat": "http://localhost:%s"
            }
        }
    ]
}
