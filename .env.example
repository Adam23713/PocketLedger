#  PocketLedger production configuration template
#
#  Copy this file to .env, replace every placeholder and restrict the copy to its
#  owner (chmod 600 .env). Never commit the filled-in file. Step-by-step setup:
#  docs/deployment.md. Sections marked OPTIONAL can stay empty.


############################### 1. COMPOSE PROJECT ###############################
#  Docker Compose identifies containers, networks and database volumes by the
#  project name, not by the checkout directory. Keep it stable for the whole
#  life of the deployment: changing it silently starts on empty databases.
##################################################################################
COMPOSE_PROJECT_NAME=pocketledger


############################### 2. PUBLIC DOMAINS ################################
#  The five public hostnames behind Cloudflare and Caddy: the landing page, the
#  documentation, the web app, the API and the Identity (sign-in) server. The
#  relevant application hostnames also become OAuth redirect and token issuer
#  URLs, so they must match the DNS records.
#  The theme cookie domain lets every subdomain share the chosen appearance;
#  use the parent domain with a leading dot.
##################################################################################
POCKETLEDGER_LANDING_DOMAIN=pocketledger.dev
POCKETLEDGER_DOCS_DOMAIN=docs.pocketledger.dev
POCKETLEDGER_WEB_DOMAIN=app.pocketledger.dev
POCKETLEDGER_API_DOMAIN=api.pocketledger.dev
POCKETLEDGER_IDENTITY_DOMAIN=identity.pocketledger.dev
POCKETLEDGER_THEME_COOKIE_DOMAIN=.pocketledger.dev


######################### 3. SERVICE-TO-SERVICE SECRETS ##########################
#  Secrets the services use to trust each other. Each one must be a different
#  long random value; never reuse one for another purpose.
#  - WEB_CLIENT_SECRET:    the Web app authenticates itself to Identity with it
#                          when it exchanges sign-in codes for tokens.
#  - ADMIN_OPERATIONS_KEY: authorizes Identity's admin calls to the API and Web
#                          (blocking users, ending sessions, deleting users).
#  - SIGNING_KEY:          signs the tokens Identity issues; the API and Web use
#                          it to verify them. Generate: openssl rand -base64 64
##################################################################################
POCKETLEDGER_WEB_CLIENT_SECRET=replace-with-a-long-random-secret
POCKETLEDGER_ADMIN_OPERATIONS_KEY=replace-with-a-separate-long-random-secret
POCKETLEDGER_SIGNING_KEY=replace-with-a-base64-encoded-random-key-of-at-least-32-bytes


################################## 4. DATABASES ##################################
#  Credentials for the three PostgreSQL databases (web, api, identity). They
#  are only reachable on the internal Docker network, but still use a strong
#  password: it is the last line of defence if a container is compromised.
##################################################################################
POSTGRES_USER=pocketledger
POSTGRES_PASSWORD=change-this-password


##################### 5. FIRST ADMINISTRATOR & REGISTRATION ######################
#  The first account is created once by `bootstrap-identity` from these values
#  and becomes the administrator; its data recovery key is printed only then.
#  The registration values are only initial defaults: once they are saved on
#  the Identity admin dashboard, the dashboard settings take precedence.
#  MAXIMUM_USERS includes the administrator; leave it empty for no limit.
##################################################################################
POCKETLEDGER_INITIAL_USERNAME=replace-me
POCKETLEDGER_INITIAL_PASSWORD=replace-me
POCKETLEDGER_PUBLIC_REGISTRATION_ENABLED=false
POCKETLEDGER_PUBLIC_REGISTRATION_MAXIMUM_USERS=5


########################## 6. EDGE SECURITY (CROWDSEC) ###########################
#  CrowdSec bans abusive IP addresses. Two independent keys keep the blast
#  radius small:
#  - CROWDSEC_API_KEY:          used by Caddy to enforce bans on every request.
#  - CROWDSEC_IDENTITY_API_KEY: read-only, used by the Identity admin dashboard
#                               to show active decisions. Never reuse the other.
#  Generate each with: openssl rand -hex 32. Changing a value here does not
#  rotate an already registered key; see docs/edge-security.md.
##################################################################################
CROWDSEC_API_KEY=replace-with-a-long-random-bouncer-key
CROWDSEC_IDENTITY_API_KEY=replace-with-a-different-long-random-bouncer-key


####################### 7. ENCRYPTION KEYS & INTERNAL TLS ########################
#  Host directory holding each service's encryption key ring and certificate,
#  plus the private CA used for TLS between the services. Create it before the
#  first start with tools/initialize-encryption-keys.sh and
#  tools/initialize-internal-tls.sh. Compose mounts only each service's own
#  subdirectory. Back it up separately from the databases: without these keys
#  the encrypted database fields cannot be read.
##################################################################################
POCKETLEDGER_SECURITY_DIRECTORY=/opt/pocketledger-security


######################### 8. OCI VAULT / KMS (OPTIONAL) ##########################
#  Only used with compose.oci-kms*.yaml. Each service's key ring is then
#  wrapped by its own Oracle Cloud Vault key, so a copied server disk alone is
#  not enough to unlock it. One key OCID per service keeps them isolated.
#  Setup and migration: docs/oci-kms.md.
##################################################################################
POCKETLEDGER_OCI_CRYPTO_ENDPOINT=https://replace-with-vault-crypto-endpoint
POCKETLEDGER_OCI_API_KEY_ID=ocid1.key.oc1.eu-frankfurt-1.replace-me
POCKETLEDGER_OCI_WEB_KEY_ID=ocid1.key.oc1.eu-frankfurt-1.replace-me
POCKETLEDGER_OCI_IDENTITY_KEY_ID=ocid1.key.oc1.eu-frankfurt-1.replace-me
POCKETLEDGER_OCI_TIMEOUT_SECONDS=10
POCKETLEDGER_OCI_MAX_ATTEMPTS=3


########################## 9. SOCIAL SIGN-IN (OPTIONAL) ##########################
#  Google and Facebook login. Each provider appears on the sign-in and
#  registration pages only when both of its values are set; leave them empty
#  to keep it disabled. Callback URLs and app setup: docs/deployment.md.
##################################################################################
POCKETLEDGER_GOOGLE_CLIENT_ID=
POCKETLEDGER_GOOGLE_CLIENT_SECRET=
POCKETLEDGER_FACEBOOK_APP_ID=
POCKETLEDGER_FACEBOOK_APP_SECRET=


###################### 10. LANDING CONTACT FORM (OPTIONAL) #######################
#  The /contact page sends visitor messages to RECIPIENT by email. It stays
#  disabled until both Turnstile keys and the SMTP host and sender are set.
#  - TURNSTILE_*: Cloudflare's bot check. Create a widget in the Cloudflare
#                 dashboard (managed mode, hostname = the landing domain).
#  - SMTP_*:      the outgoing mail server. Use StartTls (usually port 587) or
#                 SslOnConnect (usually port 465). SMTP_FROM must be an address
#                 the provider may send as (SPF/DKIM/DMARC).
#  Also copy the contact rate limit and client IP header from
#  Caddyfile.example into the deployed Caddyfile.
##################################################################################
POCKETLEDGER_TURNSTILE_SITE_KEY=
POCKETLEDGER_TURNSTILE_SECRET_KEY=
POCKETLEDGER_CONTACT_RECIPIENT=info@pocketledger.dev
POCKETLEDGER_CONTACT_SMTP_HOST=
POCKETLEDGER_CONTACT_SMTP_PORT=587
POCKETLEDGER_CONTACT_SMTP_SECURITY=StartTls
POCKETLEDGER_CONTACT_SMTP_USERNAME=
POCKETLEDGER_CONTACT_SMTP_PASSWORD=
POCKETLEDGER_CONTACT_SMTP_FROM=


###################### 11. LANDING VIDEO (OPTIONAL) ##############################
#  A YouTube link (watch, youtu.be, embed or shorts URL) shown on the landing
#  page. It is embedded through youtube-nocookie.com. Leave it empty to hide
#  the video section.
##################################################################################
POCKETLEDGER_LANDING_YOUTUBE_URL=https://www.youtube.com/watch?v=2PuFyjAs7JA
