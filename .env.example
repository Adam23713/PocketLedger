POCKETLEDGER_LANDING_DOMAIN=pocketledger.dev
POCKETLEDGER_WEB_DOMAIN=app.pocketledger.dev
POCKETLEDGER_API_DOMAIN=api.pocketledger.dev
POCKETLEDGER_IDENTITY_DOMAIN=identity.pocketledger.dev
POCKETLEDGER_WEB_CLIENT_SECRET=replace-with-a-long-random-secret
POCKETLEDGER_SIGNING_KEY=replace-with-a-base64-encoded-random-key-of-at-least-32-bytes
POSTGRES_USER=pocketledger
POSTGRES_PASSWORD=change-this-password
POCKETLEDGER_INITIAL_USERNAME=replace-me
POCKETLEDGER_INITIAL_PASSWORD=replace-me
# Generate with: openssl rand -hex 32
CROWDSEC_API_KEY=replace-with-a-long-random-bouncer-key

# Prepare host keys/certificates and internal TLS material first; see README.md.
POCKETLEDGER_SECURITY_DIRECTORY=/opt/pocketledger-security

# OCI KMS override settings; required only with compose.oci-kms*.yaml.
POCKETLEDGER_OCI_CRYPTO_ENDPOINT=https://replace-with-vault-crypto-endpoint
POCKETLEDGER_OCI_API_KEY_ID=ocid1.key.oc1.eu-frankfurt-1.replace-me
POCKETLEDGER_OCI_WEB_KEY_ID=ocid1.key.oc1.eu-frankfurt-1.replace-me
POCKETLEDGER_OCI_IDENTITY_KEY_ID=ocid1.key.oc1.eu-frankfurt-1.replace-me
POCKETLEDGER_OCI_TIMEOUT_SECONDS=10
POCKETLEDGER_OCI_MAX_ATTEMPTS=3
